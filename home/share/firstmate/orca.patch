diff --git a/bin/fm-orca-process-lib.sh b/bin/fm-orca-process-lib.sh
index 6ef0df2..453be4a 100755
--- a/bin/fm-orca-process-lib.sh
+++ b/bin/fm-orca-process-lib.sh
@@ -312,6 +312,29 @@ fm_orca_process_supervisor_owner_pid() {  # <current-tty>
   printf '%s' "$candidate"
 }
 
+# Pi's bash tool has pipe-based stdin. Follow only the current process ancestry
+# to its Pi owner; never discover a candidate by scanning other terminals.
+fm_orca_process_supervisor_pi_ancestor() {
+  local pid=${FM_ORCA_SUPERVISOR_PARENT_PID_OVERRIDE:-$PPID} attempt=0 comm args parent class
+  while [ "$attempt" -lt 16 ]; do
+    attempt=$((attempt + 1))
+    case "$pid" in ''|*[!0-9]*|0|1) return 1 ;; esac
+    comm=$(fm_orca_process_ps_field "$pid" comm) || return 1
+    args=$(fm_orca_process_ps_field "$pid" args) || return 1
+    if fm_orca_process_pi_process_matches "$comm" "$args"; then
+      printf '%s' "$pid"
+      return 0
+    fi
+    fm_orca_process_load_classifier || return 1
+    class=$(fm_backend_tmux_classify_process_name "$comm" "${args%%[[:space:]]*}")
+    [ "$class" = shell ] || return 1
+    parent=$(fm_orca_process_ps_field "$pid" ppid) || return 1
+    [ "$parent" != "$pid" ] || return 1
+    pid=$parent
+  done
+  return 1
+}
+
 # Enroll the exact local process that owns an Orca primary before it execs Pi,
 # or the exact Pi ancestor when /afk is invoked from Pi's bash tool. The caller
 # already captured the current-pane tuple and passes every field again so a
@@ -320,7 +343,7 @@ fm_orca_process_supervisor_bind() {  # <binding> <terminal> <worktree-id> <workt
   [ "$#" -eq 9 ] || return 2
   local binding=$1 terminal=$2 worktree_id=$3 worktree_path=$4 pty_id=$5
   local incarnation_id=$6 tab_id=$7 leaf_id=$8 execution_host_id=$9
-  local facts observed_tty owner_pid birth owner_tty cwd tmp old_umask
+  local facts observed_tty owner_pid='' birth owner_tty cwd tmp old_umask require_pi=0
   [ "$execution_host_id" = local ] && [ -d "$(dirname "$binding")" ] && [ ! -d "$binding" ] || return 1
   facts=$(fm_orca_process_terminal_facts "$terminal") || return 1
   fm_orca_process_facts_match_tuple "$facts" "$terminal" "$worktree_id" "$worktree_path" \
@@ -328,10 +351,16 @@ fm_orca_process_supervisor_bind() {  # <binding> <terminal> <worktree-id> <workt
   if [ -n "${FM_ORCA_SUPERVISOR_SELF_TTY_OVERRIDE:-}" ]; then
     observed_tty=$FM_ORCA_SUPERVISOR_SELF_TTY_OVERRIDE
   else
-    observed_tty=$(${FM_ORCA_TTY_BIN:-tty} 2>/dev/null) || return 1
+    if ! observed_tty=$(${FM_ORCA_TTY_BIN:-tty} 2>/dev/null); then
+      owner_pid=$(fm_orca_process_supervisor_pi_ancestor) || return 1
+      observed_tty=$(fm_orca_process_ps_field "$owner_pid" tty) || return 1
+      require_pi=1
+    fi
   fi
   observed_tty=$(fm_orca_process_tty_normalize "$observed_tty") || return 1
-  owner_pid=$(fm_orca_process_supervisor_owner_pid "$observed_tty") || return 1
+  if [ -z "$owner_pid" ]; then
+    owner_pid=$(fm_orca_process_supervisor_owner_pid "$observed_tty") || return 1
+  fi
   birth=$(fm_orca_process_ps_field "$owner_pid" lstart) || return 1
   owner_tty=$(fm_orca_process_ps_field "$owner_pid" tty) || return 1
   owner_tty=$(fm_orca_process_tty_normalize "$owner_tty") || return 1
@@ -360,6 +389,10 @@ fm_orca_process_supervisor_bind() {  # <binding> <terminal> <worktree-id> <workt
     return 1
   fi
   chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
+  if [ "$require_pi" -eq 1 ] && ! fm_orca_process_foreground_pi_from_binding "$tmp" "$terminal" >/dev/null; then
+    rm -f "$tmp"
+    return 1
+  fi
   mv -f "$tmp" "$binding"
 }
 
