+test_supervisor_binding_from_piped_pi_tool() {
+  local binding
+  reset_identity
+  binding="$STATE/.piped-primary"
+  printf 'pi\n' > "$FAKE/comm.4242"
+  printf '/opt/homebrew/bin/pi\n' > "$FAKE/args.4242"
+  printf '4242 4242 4242 /opt/homebrew/bin/pi\n' > "$FAKE/rows"
+  FM_ORCA_SUPERVISOR_PARENT_PID_OVERRIDE=4242 FM_ORCA_TTY_BIN=false \
+    fm_orca_process_supervisor_bind "$binding" term-1 "repo-1::$WT" "$WT" \
+      pty-1 inc-1 tab-1 leaf-1 local || fail "piped Pi tool should enroll its foreground parent"
+  [ "$(fm_orca_process_record_get "$binding" process_pid)" = 4242 ] || fail "wrong Pi owner"
+  rm "$binding"
+  printf '4242 4242 9000 /opt/homebrew/bin/pi\n' > "$FAKE/rows"
+  FM_ORCA_SUPERVISOR_PARENT_PID_OVERRIDE=4242 FM_ORCA_TTY_BIN=false \
+    fm_orca_process_supervisor_bind "$binding" term-1 "repo-1::$WT" "$WT" \
+      pty-1 inc-1 tab-1 leaf-1 local && fail "background Pi must not enroll"
+  [ ! -e "$binding" ] || fail "refused Pi enrollment published a binding"
+  printf '/bin/sleep\n' > "$FAKE/comm.4242"
+  printf '/bin/sleep 30\n' > "$FAKE/args.4242"
+  FM_ORCA_SUPERVISOR_PARENT_PID_OVERRIDE=4242 FM_ORCA_TTY_BIN=false \
+    fm_orca_process_supervisor_bind "$binding" term-1 "repo-1::$WT" "$WT" \
+      pty-1 inc-1 tab-1 leaf-1 local && fail "unrelated piped process must not enroll"
+  pass "fm-orca-process supervisor: piped Pi tools prove exact foreground ancestry"
+}
