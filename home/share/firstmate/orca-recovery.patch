diff --git a/bin/fm-tangle-lib.sh b/bin/fm-tangle-lib.sh
index a8554fb..9823d4b 100644
--- a/bin/fm-tangle-lib.sh
+++ b/bin/fm-tangle-lib.sh
@@ -35,6 +35,44 @@ fm_default_branch() {
   return 1
 }
 
+# Orca gives persistent homes a named branch. Accept only the exact seeded
+# identity in a linked checkout; an ordinary feature branch still alarms.
+fm_orca_secondmate_branch_valid() {  # <home> <branch>
+  local root=$1 branch=$2 real top
+  [ -f "$root/.git" ] && [ ! -L "$root/.git" ] || return 1
+  real=$(cd "$root" && pwd -P) || return 1
+  top=$(git -C "$real" rev-parse --show-toplevel 2>/dev/null) || return 1
+  [ "$top" = "$real" ] || return 1
+  node - "$real" "$branch" <<'JS'
+const fs = require('fs');
+const path = require('path');
+const [home, branch] = process.argv.slice(2);
+try {
+  const read = name => {
+    const p = path.join(home, name);
+    if (!fs.lstatSync(p).isFile()) throw new Error('not a regular file');
+    const text = fs.readFileSync(p, 'utf8');
+    if (/[\x00-\x08\x0b-\x1f\x7f]/.test(text)) throw new Error('control byte');
+    return text.trimEnd();
+  };
+  const id = read('.fm-secondmate-home');
+  if (!/^[A-Za-z0-9._-]+$/.test(id) || branch !== `fm-${id}`) process.exit(1);
+  const rows = read('.fm-secondmate-orca').split('\n').map(line => {
+    const at = line.indexOf('=');
+    if (at < 1) throw new Error('invalid row');
+    return [line.slice(0, at), line.slice(at + 1)];
+  });
+  const record = Object.fromEntries(rows);
+  if (rows.length !== 4 || Object.keys(record).length !== 4
+      || record.schema !== 'fm-secondmate-orca.v1' || record.id !== id
+      || record.path !== home) process.exit(1);
+  const prefix = record.worktree_id?.slice(0, 38);
+  if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}::$/.test(prefix || '')
+      || record.worktree_id !== prefix + home) process.exit(1);
+} catch { process.exit(1); }
+JS
+}
+
 # If the git checkout at <root> is tangled - on a NAMED branch that is not its
 # default branch - echo the offending branch name and return 0. For every healthy
 # state (not a git work tree, detached HEAD, or already on the default branch)
@@ -48,6 +86,7 @@ fm_primary_tangle_branch() {
   [ -n "$cur" ] || return 1
   default=$(fm_default_branch "$root") || return 1
   [ "$cur" = "$default" ] && return 1
+  fm_orca_secondmate_branch_valid "$root" "$cur" && return 1
   printf '%s\n' "$cur"
   return 0
 }
