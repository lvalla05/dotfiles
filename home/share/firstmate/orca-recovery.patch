+++ b/tests/fm-orca-home-sync.test.sh
@@ -0,0 +1,57 @@
+#!/usr/bin/env bash
+# Real Git proof for named Orca home branches and guarded source updates.
+set -eu
+# shellcheck source=tests/fixtures.sh
+. "$(dirname "${BASH_SOURCE[0]}")/fixtures.sh"
+# shellcheck source=bin/fm-ff-lib.sh
+. "$ROOT/bin/fm-ff-lib.sh"
+fm_git_identity fmtest fmtest@example.invalid
+case_root=$(fm_test_tmproot fm-orca-home-sync)
+primary="$case_root/primary"
+home="$case_root/home"
+git init -q -b main "$primary"
+printf '.fm-secondmate-*\nstate/\n' > "$primary/.gitignore"
+printf 'one\n' > "$primary/version"
+git -C "$primary" add .
+git -C "$primary" commit -qm initial
+git -C "$primary" worktree add -qb fm-owned "$home"
+printf 'owned\n' > "$home/.fm-secondmate-home"
+printf 'schema=fm-secondmate-orca.v1\nid=owned\nworktree_id=11111111-2222-4333-8444-555555555555::%s\npath=%s\n' \
+  "$home" "$home" > "$home/.fm-secondmate-orca"
+mkdir "$home/state"
+printf 'retained\n' > "$home/state/task"
+fm_orca_secondmate_branch_valid "$home" fm-owned || fail 'valid seeded branch refused'
+[ -z "$(fm_primary_tangle_branch "$home" || true)" ] || fail 'seeded home reported as primary tangle'
+printf 'two\n' > "$primary/version"
+git -C "$primary" commit -qam update
+target=$(git -C "$primary" rev-parse HEAD)
+ff_target "$home" owned "$target" yes yes >/dev/null
+[ "$FF_STATUS" = updated ] || fail 'named home did not fast-forward'
+[ "$(git -C "$home" rev-parse HEAD)" = "$target" ] || fail 'wrong updated revision'
+[ "$(cat "$home/state/task")" = retained ] || fail 'operational state changed'
+[ "$(git -C "$home" branch --show-current)" = fm-owned ] || fail 'home branch changed'
+printf 'three\n' > "$primary/version"
+git -C "$primary" commit -qam next
+next=$(git -C "$primary" rev-parse HEAD)
+printf 'local edit\n' >> "$home/version"
+ff_target "$home" owned "$next" yes yes >/dev/null
+[ "$FF_STATUS" = skipped ] || fail 'dirty home advanced'
+git -C "$home" restore version
+git -C "$home" switch -qc feature
+[ "$(fm_primary_tangle_branch "$home")" = feature ] || fail 'wrong branch did not alarm'
+ff_target "$home" owned "$next" yes yes >/dev/null
+[ "$FF_STATUS" = skipped ] || fail 'wrong branch advanced'
+git -C "$home" switch -q fm-owned
+cp "$home/.fm-secondmate-orca" "$case_root/marker"
+printf 'id=owned\n' >> "$home/.fm-secondmate-orca"
+if fm_orca_secondmate_branch_valid "$home" fm-owned; then fail 'duplicate marker accepted'; fi
+ff_target "$home" owned "$next" yes yes >/dev/null
+[ "$FF_STATUS" = skipped ] || fail 'invalid marker advanced'
+cp "$case_root/marker" "$home/.fm-secondmate-orca"
+printf 'own commit\n' > "$home/version"
+git -C "$home" commit -qam diverged
+before=$(git -C "$home" rev-parse HEAD)
+ff_target "$home" owned "$next" yes yes >/dev/null
+[ "$FF_STATUS" = skipped ] || fail 'diverged home advanced'
+[ "$(git -C "$home" rev-parse HEAD)" = "$before" ] || fail 'diverged work changed'
+pass 'Orca named home: exact identity, guarded fast-forward, retained state, dirty/wrong-branch/malformed/diverged refusal'
