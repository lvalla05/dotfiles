+fm_backend_orca_worktree_id_path() {  # <full-worktree-id>
+  local value=${1:-} repo_id embedded_path
+  case "$value" in
+    *::/*) ;;
+    *) return 1 ;;
+  esac
+  repo_id=${value%%::*}
+  embedded_path=${value#*::}
+  case "$repo_id" in
+    ''|*[!A-Za-z0-9._@%+-]*) return 1 ;;
+  esac
+  [ -n "$embedded_path" ] || return 1
+  ! printf '%s' "$value" | LC_ALL=C grep -q '[[:cntrl:]]' || return 1
+  printf '%s' "$embedded_path"
+}
+
+fm_backend_orca_filesystem_path_state() {  # <absolute-path> -> absent|present|unknown
+  node -e '
+const fs = require("fs");
+try {
+  fs.lstatSync(process.argv[1]);
+  process.stdout.write("present");
+} catch (err) {
+  process.stdout.write(err && err.code === "ENOENT" ? "absent" : "unknown");
+}
+' "$1"
+}
+
+fm_backend_orca_json_error_code_is() {  # <json> <exact-code>
+  printf '%s' "$1" | node -e '
+const fs = require("fs");
+let data;
+try { data = JSON.parse(fs.readFileSync(0, "utf8")); } catch { process.exit(1); }
+process.exit(data && data.ok === false && data.error && data.error.code === process.argv[1] ? 0 : 1);
+' "$2"
+}
