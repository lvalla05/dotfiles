+      return 0
+    fi
   else
-    fm_backend_orca_run_json orca worktree rm --worktree "id:$worktree_id" --json
+    if out=$(orca worktree rm --worktree "id:$worktree_id" --json) \
+       && remove_error=$(printf '%s' "$out" | fm_backend_orca_json_ok 2>&1); then
+      return 0
+    fi
+  fi
+
+  path_state=$(fm_backend_orca_filesystem_path_state "$worktree_path") || path_state=unknown
+  case "$path_state" in
+    absent) ;;
+    present)
+      echo "error: Orca worktree removal was not confirmed and its recorded path still exists: $worktree_path" >&2
+      if [ -n "$remove_error" ]; then
+        printf '%s\n' "$remove_error" >&2
+      else
+        printf '%s' "$out" | fm_backend_orca_json_ok || true
+      fi
+      return 1
+      ;;
+    *)
+      echo "error: Orca worktree removal was not confirmed and filesystem absence could not be proved: $worktree_path" >&2
+      if [ -n "$remove_error" ]; then
+        printf '%s\n' "$remove_error" >&2
+      else
+        printf '%s' "$out" | fm_backend_orca_json_ok || true
+      fi
+      return 1
+      ;;
+  esac
+
+  show_out=$(orca worktree show --worktree "id:$worktree_id" --json 2>/dev/null || true)
+  if ! fm_backend_orca_json_error_code_is "$show_out" selector_not_found; then
+    if [ -n "$show_out" ]; then
+      show_error=$(printf '%s' "$show_out" | fm_backend_orca_json_ok 2>&1) || true
+    fi
+    if [ -n "$show_error" ]; then
+      printf '%s\n' "$show_error" >&2
+    elif [ -n "$remove_error" ]; then
+      printf '%s\n' "$remove_error" >&2
+    else
+      printf '%s' "$out" | fm_backend_orca_json_ok || true
+    fi
+    return 1
   fi
+  fm_backend_orca_runtime_check || return 1
+  return 0
