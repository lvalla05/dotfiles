+#!/usr/bin/env bash
+# Focused fake-Orca proof for persistent secondmate ownership and lifecycle.
+set -u
+
+# shellcheck source=tests/lib.sh
+. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
+
+TMP_ROOT=$(fm_test_tmproot fm-orca-secondmate)
+SOURCE="$TMP_ROOT/firstmate-source"
+PARENT="$TMP_ROOT/parent-home"
+ORCA_HOME="$TMP_ROOT/orca-home"
+FAKE="$TMP_ROOT/fakebin"
+LOG="$TMP_ROOT/orca.log"
+USER_HOME="$TMP_ROOT/user-home"
+ID=orcamate
+REPO_ID=11111111-2222-4333-8444-555555555555
+
+setup_source_and_parent() {
+  git clone --quiet "$ROOT" "$SOURCE"
+  if ! grep -Fx '.fm-secondmate-orca' "$SOURCE/.gitignore" >/dev/null 2>&1; then
+    printf '%s\n' '.fm-secondmate-orca' >> "$SOURCE/.gitignore"
+    git -C "$SOURCE" add .gitignore
+    git -C "$SOURCE" -c user.name='Firstmate Tests' -c user.email='tests@example.invalid' \
+      commit -qm 'ignore persistent Orca ownership marker'
+  fi
+  printf 'fixture\n' > "$SOURCE/.fm-orca-seed-fixture"
+  git -C "$SOURCE" add .fm-orca-seed-fixture
+  git -C "$SOURCE" -c user.name='Firstmate Tests' -c user.email='tests@example.invalid' \
+    commit -qm 'add Orca seed test revision'
+  mkdir -p "$PARENT/data" "$PARENT/state" "$PARENT/config" "$PARENT/projects" "$USER_HOME" "$FAKE"
+  : > "$LOG"
+}
+
+install_fake_orca() {
+  cat > "$FAKE/orca" <<'SH'
+#!/usr/bin/env bash
+set -u
+printf '%s\n' "$*" >> "$FM_FAKE_ORCA_LOG"
+case "${1:-} ${2:-}" in
+  status\ *)
+    printf '%s\n' '{"ok":true,"result":{"runtime":{"reachable":true,"state":"ready"}}}'
+    ;;
+  'repo show')
+    printf '%s\n' "{\"ok\":true,\"result\":{\"repo\":{\"id\":\"11111111-2222-4333-8444-555555555555\",\"hookSettings\":{\"setupAgentStartupPolicy\":\"${FM_FAKE_ORCA_STARTUP_POLICY:-start-immediately}\"}}}}"
+    ;;
+  'worktree create')
+    base=
+    prev=
+    for arg in "$@"; do
+      [ "$prev" != --base-branch ] || base=$arg
+      prev=$arg
+    done
+    [ -n "$base" ] || { printf '%s\n' '{"ok":false,"error":{"message":"missing exact base"}}'; exit 1; }
+    if [ "${FM_FAKE_ORCA_IGNORE_BASE:-0}" = 1 ]; then
+      base=$(git -C "$FM_FAKE_ORCA_SOURCE" rev-parse "$base^") || exit 1
+    fi
+    if [ "${FM_FAKE_ORCA_FOREIGN_STORE:-0}" = 1 ]; then
+      git clone --quiet "$FM_FAKE_ORCA_SOURCE" "$FM_FAKE_ORCA_HOME" || exit 1
+      git -C "$FM_FAKE_ORCA_HOME" checkout --quiet --detach "$base" || exit 1
+    else
+      git -C "$FM_FAKE_ORCA_SOURCE" worktree add --quiet --detach "$FM_FAKE_ORCA_HOME" "$base" || exit 1
+    fi
+    printf '{"ok":true,"result":{"worktree":{"id":"%s::%s","path":"%s"},"startupTerminal":{"handle":"term-setup"}}}\n' \
+      "$FM_FAKE_ORCA_REPO_ID" "$FM_FAKE_ORCA_HOME" "$FM_FAKE_ORCA_HOME"
+    ;;
+  'worktree show')
+    printf '{"ok":true,"result":{"worktree":{"id":"%s::%s","path":"%s"}}}\n' \
+      "$FM_FAKE_ORCA_REPO_ID" "$FM_FAKE_ORCA_HOME" "$FM_FAKE_ORCA_HOME"
+    ;;
+  'worktree rm')
+    force=
+    for arg in "$@"; do [ "$arg" != --force ] || force=--force; done
+    if [ -n "$force" ]; then
+      git -C "$FM_FAKE_ORCA_SOURCE" worktree remove --force "$FM_FAKE_ORCA_HOME" || exit 1
+    else
+      git -C "$FM_FAKE_ORCA_SOURCE" worktree remove "$FM_FAKE_ORCA_HOME" || exit 1
+    fi
+    printf '%s\n' '{"ok":true,"result":{"removed":true}}'
+    ;;
+  'terminal create')
+    printf '%s\n' '{"ok":true,"result":{"terminal":{"handle":"term-agent"}}}'
+    ;;
+  'terminal list')
+    if [ "${FM_FAKE_ORCA_NO_TERMINALS:-0}" = 1 ]; then
+      printf '%s\n' '{"ok":true,"result":{"terminals":[],"truncated":false,"totalCount":0,"hostScope":{"omittedHostIds":[]}}}'
+    else
+      printf '{"ok":true,"result":{"terminals":[{"handle":"term-setup","ptyId":"pty-setup","incarnationId":"inc-setup","orphaned":false,"worktreeId":"%s::%s","worktreePath":"%s","tabId":"tab-setup","leafId":"leaf-setup","executionHostId":"local"}],"truncated":false,"totalCount":1,"hostScope":{"omittedHostIds":[]}}}\n' \
+        "$FM_FAKE_ORCA_REPO_ID" "$FM_FAKE_ORCA_HOME" "$FM_FAKE_ORCA_HOME"
+    fi
+    ;;
+  'terminal close')
+    terminal=
+    prev=
+    for arg in "$@"; do
+      [ "$prev" != --terminal ] || terminal=$arg
+      prev=$arg
+    done
+    if [ "$terminal" = term-agent ] && [ "${FM_FAKE_ORCA_AGENT_CLOSE_FAIL:-0}" = 1 ]; then
+      printf '%s\n' '{"ok":false,"error":{"message":"agent terminal close refused"}}'
+      exit 1
+    fi
+    printf '%s\n' '{"ok":true,"result":{"closed":true}}'
+    ;;
+  'terminal send')
+    if [ "${FM_FAKE_ORCA_INSTALL_BINDING:-0}" = 1 ] && printf '%s\n' "$*" | grep -F 'fm-orca-process-lib.sh' >/dev/null; then
+      meta="$FM_STATE_OVERRIDE/$FM_ORCA_PROOF_TASK_ID.meta"
+      spawn_gen=$(sed -n 's/^spawn_gen=//p' "$meta")
+      worktree_id=$(sed -n 's/^orca_worktree_id=//p' "$meta")
+      worktree_path=$(sed -n 's/^worktree=//p' "$meta")
+      cat > "$FM_STATE_OVERRIDE/$FM_ORCA_PROOF_TASK_ID.orca-process" <<EOF
+schema=fm-orca-process.v1
+task_id=$FM_ORCA_PROOF_TASK_ID
+spawn_gen=$spawn_gen
+terminal=term-agent
+worktree_id=$worktree_id
+worktree_path=$worktree_path
+pty_id=pty-proof
+incarnation_id=inc-proof
+tab_id=tab-proof
+leaf_id=leaf-proof
+execution_host_id=local
+shell_pid=4242
+shell_birth=Mon Sep  6 18:00:00 2026
+shell_tty=/dev/ttys999
+EOF
+      chmod 600 "$FM_STATE_OVERRIDE/$FM_ORCA_PROOF_TASK_ID.orca-process"
+    fi
+    printf '%s\n' '{"ok":true,"result":{"send":{"accepted":true}}}'
+    ;;
+  'terminal show')
+    meta="$FM_STATE_OVERRIDE/$FM_ORCA_PROOF_TASK_ID.meta"
+    worktree_id=$(sed -n 's/^orca_worktree_id=//p' "$meta")
+    worktree_path=$(sed -n 's/^worktree=//p' "$meta")
+    printf '{"ok":true,"result":{"terminal":{"handle":"term-agent","ptyId":"pty-proof","incarnationId":"inc-proof","orphaned":false,"worktreeId":"%s","worktreePath":"%s","tabId":"tab-proof","leafId":"leaf-proof","executionHostId":"local"}}}\n' \
+      "$worktree_id" "$worktree_path"
+    ;;
+  'terminal read')
+    printf '%s\n' '{"ok":true,"result":{"terminal":{"source":"screen","tail":["ready"]}}}'
+    ;;
+  *)
+    printf '%s\n' '{"ok":false,"error":{"message":"unexpected fake Orca command"}}'
+    exit 1
+    ;;
+esac
+SH
+  cat > "$FAKE/fake-ps" <<'SH'
+#!/usr/bin/env bash
+case "$*" in
+  *'-p 4242 -o lstart='*) printf '%s\n' 'Mon Sep  6 18:00:00 2026' ;;
+  *'-p 4242 -o tty='*) printf '%s\n' 'ttys999' ;;
+  *'-t ttys999 -o pid=,pgid=,tpgid=,comm='*) printf '%s\n' '5252 5252 5252 claude' ;;
+  *'-p 5252 -o args='*) printf '%s\n' 'claude --dangerously-skip-permissions' ;;
+  *) exit 1 ;;
+esac
+SH
+  cat > "$FAKE/fake-lsof" <<'SH'
+#!/usr/bin/env bash
+meta="$FM_STATE_OVERRIDE/$FM_ORCA_PROOF_TASK_ID.meta"
+printf 'p4242\nfcwd\nn%s\n' "$(sed -n 's/^worktree=//p' "$meta")"
+SH
+  cat > "$FAKE/claude" <<'SH'
+#!/usr/bin/env bash
+exit 0
+SH
+  chmod +x "$FAKE/orca" "$FAKE/claude" "$FAKE/fake-ps" "$FAKE/fake-lsof"
+}
+
+orca_env() {
+  local selected_parent=${FM_HOME:-$PARENT}
+  HOME="$USER_HOME" CLAUDE_CONFIG_DIR='' PATH="$FAKE:$PATH" \
+    FM_FAKE_ORCA_LOG="$LOG" FM_FAKE_ORCA_SOURCE="$SOURCE" \
+    FM_FAKE_ORCA_HOME="${FM_FAKE_ORCA_HOME:-$ORCA_HOME}" FM_FAKE_ORCA_REPO_ID="$REPO_ID" \
+    FM_ORCA_PROOF_TASK_ID="${FM_ORCA_PROOF_TASK_ID:-$ID}" \
+    FM_ORCA_PS_BIN="$FAKE/fake-ps" FM_ORCA_LSOF_BIN="$FAKE/fake-lsof" \
+    FM_ROOT_OVERRIDE="$SOURCE" FM_HOME="$selected_parent" \
+    FM_STATE_OVERRIDE="${FM_STATE_OVERRIDE:-$selected_parent/state}" \
+    FM_DATA_OVERRIDE="${FM_DATA_OVERRIDE:-$selected_parent/data}" \
+    FM_CONFIG_OVERRIDE="${FM_CONFIG_OVERRIDE:-$selected_parent/config}" \
+    FM_PROJECTS_OVERRIDE="${FM_PROJECTS_OVERRIDE:-$selected_parent/projects}" "$@"
+}
+
+test_explicit_orca_adoption() {
+  local id=adoptmate parent="$TMP_ROOT/adopt-parent" home="$TMP_ROOT/adopt-home" worktree_id out status
+  mkdir -p "$parent/data" "$parent/state" "$parent/config" "$parent/projects"
+  git -C "$SOURCE" worktree add --quiet --detach "$home" HEAD || fail "could not prepare manual adoption home"
+  FM_HOME="$parent" FM_BACKEND=tmux FM_SECONDMATE_CHARTER='manual Orca adoption' \
+    FM_SECONDMATE_SCOPE='manual Orca adoption' orca_env \
+    "$ROOT/bin/fm-home-seed.sh" "$id" "$home" --no-projects >/dev/null \
+    || fail "could not seed the manual home before adoption"
+  assert_absent "$home/.fm-secondmate-orca" "manual seed silently claimed Orca ownership"
+  worktree_id="$REPO_ID::$home"
+  out=$(FM_HOME="$parent" FM_FAKE_ORCA_HOME="$home" orca_env \
+    "$ROOT/bin/fm-home-seed.sh" adopt-orca "$id" "$worktree_id") \
+    || fail "explicit Orca adoption failed"
+  assert_contains "$out" "home=$home" "adoption did not report the registered home"
+  assert_grep "worktree_id=$worktree_id" "$home/.fm-secondmate-orca" \
+    "adoption did not bind the exact Orca worktree identity"
+
+  printf 'kind=secondmate\n' > "$parent/state/$id.meta"
+  set +e
+  out=$(FM_HOME="$parent" FM_FAKE_ORCA_HOME="$home" orca_env \
+    "$ROOT/bin/fm-home-seed.sh" adopt-orca "$id" "$worktree_id" 2>&1)
+  status=$?
+  set -e
+  [ "$status" -ne 0 ] || fail "adoption accepted a live secondmate record"
+  assert_contains "$out" 'live or recoverable task record' \
+    "adoption did not explain the live-record refusal"
+  rm -f "$parent/state/$id.meta"
+  git -C "$SOURCE" worktree remove --force "$home" || fail "could not clean manual adoption fixture"
+  pass "manual homes require explicit exact-path adoption and refuse adoption while live"
+}
+
+test_seed_refuses_wait_for_setup_before_creation() {
+  local id=waitmate home="$TMP_ROOT/wait-home" out status
+  : > "$LOG"
+  set +e
+  out=$(FM_FAKE_ORCA_HOME="$home" FM_FAKE_ORCA_STARTUP_POLICY=wait-for-setup \
+    FM_BACKEND=orca FM_SECONDMATE_CHARTER='wait policy' \
+    FM_SECONDMATE_SCOPE='wait policy' orca_env \
+    "$ROOT/bin/fm-home-seed.sh" "$id" - --no-projects 2>&1)
+  status=$?
+  set -e
+  [ "$status" -ne 0 ] || fail "Orca seed accepted a two-step custom launch under wait-for-setup"
+  assert_contains "$out" 'requires wait-for-setup' "wait policy refusal was not explained"
+  assert_no_grep 'worktree create' "$LOG" "wait policy refusal created a worktree before stopping"
+  assert_absent "$home" "wait policy refusal left a home"
+  pass "Orca seed preserves wait-for-setup by refusing before worktree creation"
+}
+
+test_seed_refuses_wrong_created_revision_with_recovery_route() {
+  local id=wrongrevision home="$TMP_ROOT/wrong-revision-home" out status marker recovered
+  : > "$LOG"
+  set +e
+  out=$(FM_FAKE_ORCA_HOME="$home" FM_FAKE_ORCA_IGNORE_BASE=1 \
+    FM_BACKEND=orca FM_SECONDMATE_CHARTER='revision proof' \
+    FM_SECONDMATE_SCOPE='revision proof' orca_env \
+    "$ROOT/bin/fm-home-seed.sh" "$id" - --no-projects 2>&1)
+  status=$?
+  set -e
+  [ "$status" -ne 0 ] || fail "Orca seed accepted a checkout that ignored the captured base revision"
+  assert_contains "$out" 'not captured source revision' "wrong revision refusal was not explained"
+  marker="$home/.fm-secondmate-orca"
+  assert_present "$marker" "wrong revision failure lost the only Orca ownership route"
+  assert_contains "$out" "recover-orca --force '$marker'" "wrong revision failure did not print its exact explicit-discard recovery command"
+  if [ -f "$PARENT/data/secondmates.md" ]; then
+    assert_no_grep "^- $id " "$PARENT/data/secondmates.md" \
+      "wrong revision failure installed a usable secondmate registry route"
+  fi
+  : > "$LOG"
+  set +e
+  out=$(FM_FAKE_ORCA_HOME="$home" orca_env \
+    "$ROOT/bin/fm-home-seed.sh" recover-orca "$marker" 2>&1)
+  status=$?
+  set -e
+  [ "$status" -ne 0 ] || fail "non-forced recovery discarded a seed with a live configured terminal"
+  assert_contains "$out" 'non-forced Orca recovery refuses 1 live terminal(s)' \
+    "default recovery did not explain its live-terminal refusal"
+  assert_present "$marker" "default recovery refusal removed its ownership marker"
+  assert_no_grep 'worktree rm' "$LOG" "default recovery reached removal with a live terminal"
+  : > "$LOG"
+  recovered=$(FM_FAKE_ORCA_HOME="$home" orca_env \
+    "$ROOT/bin/fm-home-seed.sh" recover-orca --force "$marker") \
+    || fail "marker-based recovery could not remove the failed wrong-revision seed"
+  assert_contains "$recovered" "recovered=$REPO_ID::$home" "recovery did not report its exact removed worktree"
+  assert_absent "$home" "successful recovery left the failed Orca seed home"
+  assert_grep "terminal list --worktree id:$REPO_ID::$home" "$LOG" \
+    "recovery did not positively inventory the exact worktree terminals"
+  assert_grep "worktree rm --worktree id:$REPO_ID::$home --force" "$LOG" \
+    "recovery did not remove the exact owned worktree after inventory"
+  pass "Orca seed verifies exact source revision and provides reachable marker-based recovery"
+}
+
+test_seed_refuses_foreign_repository_object_store() {
+  local id=foreignstore home="$TMP_ROOT/foreign-store-home" out status marker
+  : > "$LOG"
+  set +e
+  out=$(FM_FAKE_ORCA_HOME="$home" FM_FAKE_ORCA_FOREIGN_STORE=1 \
+    FM_BACKEND=orca FM_SECONDMATE_CHARTER='repository provenance proof' \
+    FM_SECONDMATE_SCOPE='repository provenance proof' orca_env \
+    "$ROOT/bin/fm-home-seed.sh" "$id" - --no-projects 2>&1)
+  status=$?
+  set -e
+  [ "$status" -ne 0 ] || fail "Orca seed accepted a same-revision checkout from another object store"
+  assert_contains "$out" 'does not share the captured Firstmate repository object store' \
+    "foreign repository provenance refusal was not explained"
+  marker="$home/.fm-secondmate-orca"
+  assert_present "$marker" "foreign repository refusal lost its exact Orca ownership route"
+  assert_contains "$out" "recover-orca --force '$marker'" \
+    "foreign repository refusal did not print its exact recovery command"
+  if [ -f "$PARENT/data/secondmates.md" ]; then
+    assert_no_grep "^- $id " "$PARENT/data/secondmates.md" \
+      "foreign repository checkout installed a usable secondmate route"
+  fi
+  rm -rf "$home"
+  pass "Orca seed verifies the created home's repository and object-store provenance"
+}
+
+test_recover_orca_defaults_to_nonforced_removal_without_live_terminals() {
+  local id=nonforcedrecover home="$TMP_ROOT/nonforced-recovery-home" out status marker recovered
+  : > "$LOG"
+  set +e
+  out=$(FM_FAKE_ORCA_HOME="$home" FM_FAKE_ORCA_IGNORE_BASE=1 \
+    FM_BACKEND=orca FM_SECONDMATE_CHARTER='nonforced recovery proof' \
+    FM_SECONDMATE_SCOPE='nonforced recovery proof' orca_env \
+    "$ROOT/bin/fm-home-seed.sh" "$id" - --no-projects 2>&1)
+  status=$?
+  set -e
+  [ "$status" -ne 0 ] || fail "recovery fixture unexpectedly seeded successfully"
+  marker="$home/.fm-secondmate-orca"
+  assert_present "$marker" "recovery fixture lost its ownership marker"
+  : > "$LOG"
+  recovered=$(FM_FAKE_ORCA_HOME="$home" FM_FAKE_ORCA_NO_TERMINALS=1 orca_env \
+    "$ROOT/bin/fm-home-seed.sh" recover-orca "$marker") \
+    || fail "default marker recovery could not remove a terminal-free worktree"
+  assert_contains "$recovered" "recovered=$REPO_ID::$home" \
+    "default recovery did not report its exact removed worktree"
+  assert_grep "worktree rm --worktree id:$REPO_ID::$home --json" "$LOG" \
+    "default recovery did not request non-forced worktree removal"
+  assert_no_grep '--force' "$LOG" "default terminal-free recovery silently forced removal"
+  pass "fm-home-seed recover-orca: terminal-free recovery is non-forced by default"
+}
+
+test_seed_spawn_and_safe_retire() {
+  local revision worktree_id out meta close_line remove_line
+  revision=$(git -C "$SOURCE" rev-parse HEAD)
+  worktree_id="$REPO_ID::$ORCA_HOME"
+
+  out=$(FM_BACKEND=orca FM_SECONDMATE_CHARTER='persistent Orca operations' \
+    FM_SECONDMATE_SCOPE='persistent Orca operations' orca_env \
+    "$ROOT/bin/fm-home-seed.sh" "$ID" - --no-projects) \
+    || fail "Orca secondmate seed failed"
+  assert_contains "$out" "home=$ORCA_HOME" "seed did not report the Orca-owned home"
+  assert_grep 'schema=fm-secondmate-orca.v1' "$ORCA_HOME/.fm-secondmate-orca" \
+    "seed did not write the ownership schema"
+  assert_grep "id=$ID" "$ORCA_HOME/.fm-secondmate-orca" "seed marker lost the secondmate id"
+  assert_grep "worktree_id=$worktree_id" "$ORCA_HOME/.fm-secondmate-orca" \
+    "seed marker lost the full Orca worktree identity"
+  assert_grep "path=$ORCA_HOME" "$ORCA_HOME/.fm-secondmate-orca" \
+    "seed marker lost the canonical home path"
+  assert_grep 'startup_terminal=term-setup' "$ORCA_HOME/.fm-secondmate-orca" \
+    "seed marker did not retain the unverified startup terminal"
+  assert_grep "--base-branch $revision" "$LOG" \
+    "seed did not pin Orca creation to the tested Firstmate HEAD"
+  assert_no_grep 'terminal close --terminal term-setup' "$LOG" \
+    "seed closed an unverified startup or setup terminal"
+  assert_no_grep 'treehouse' "$LOG" "Orca seed fell through to treehouse"
+  pass "Orca seed creates and marks a persistent home at exact Firstmate HEAD"
+
+  : > "$LOG"
+  touch "$PARENT/state/.last-watcher-beat"
+  FM_FAKE_ORCA_INSTALL_BINDING=1 orca_env \
+    "$ROOT/bin/fm-spawn.sh" "$ID" "$ORCA_HOME" claude --backend orca --secondmate >/dev/null \
+    || fail "Orca secondmate spawn failed"
+  meta="$PARENT/state/$ID.meta"
+  assert_grep 'kind=secondmate' "$meta" "spawn meta lost secondmate kind"
+  assert_grep 'backend=orca' "$meta" "spawn meta lost Orca backend"
+  assert_grep "worktree=$ORCA_HOME" "$meta" "spawn did not adopt the persistent home"
+  assert_grep "orca_worktree_id=$worktree_id" "$meta" "spawn lost Orca ownership identity"
+  assert_grep 'terminal=term-agent' "$meta" "spawn did not record its exact terminal"
+  assert_grep "worktree show --worktree id:$worktree_id" "$LOG" \
+    "spawn did not verify the ownership id against Orca"
+  assert_grep "terminal create --worktree id:$worktree_id --title fm-$ID" "$LOG" \
+    "spawn did not create one exact terminal in the persistent home"
+  assert_grep 'fm-orca-process-lib.sh' "$LOG" \
+    "spawn did not prefix the launch with the terminal-side process binder"
+  assert_no_grep 'terminal close --terminal term-setup' "$LOG" \
+    "spawn closed the retained startup or setup terminal"
+  assert_no_grep 'worktree create' "$LOG" "spawn created another worktree instead of adopting the home"
+  pass "Orca secondmate spawn adopts the marked home and records one exact terminal"
+
+  : > "$LOG"
+  set +e
+  FM_FAKE_ORCA_AGENT_CLOSE_FAIL=1 FM_TEARDOWN_GUARD_DONE=1 orca_env \
+    "$ROOT/bin/fm-teardown.sh" "$ID" >/dev/null 2>&1
+  teardown_status=$?
+  set -e
+  [ "$teardown_status" -ne 0 ] || fail "teardown accepted an unconfirmed Orca terminal close"
+  assert_present "$ORCA_HOME" "close failure removed the persistent home"
+  assert_present "$meta" "close failure removed durable task metadata"
+  assert_no_grep 'worktree rm' "$LOG" "close failure attempted Orca worktree removal"
+  pass "Orca secondmate teardown preserves home and records when exact close fails"
+
+  : > "$LOG"
+  FM_TEARDOWN_GUARD_DONE=1 orca_env "$ROOT/bin/fm-teardown.sh" "$ID" >/dev/null \
+    || fail "Orca secondmate retirement failed after terminal close recovered"
+  assert_absent "$ORCA_HOME" "explicit retirement left the Orca-owned home"
+  assert_absent "$meta" "explicit retirement left task metadata"
+  assert_no_grep '--force' "$LOG" "normal retirement silently forced Orca worktree removal"
+  close_line=$(grep -n '^terminal close ' "$LOG" | head -1 | cut -d: -f1)
+  remove_line=$(grep -n '^worktree rm ' "$LOG" | head -1 | cut -d: -f1)
+  [ -n "$close_line" ] && [ -n "$remove_line" ] && [ "$close_line" -lt "$remove_line" ] \
+    || fail "retirement did not close the exact terminal before removing the worktree"
+  pass "explicit retirement closes the terminal then removes only the owned Orca worktree"
+}
+
+setup_source_and_parent
+install_fake_orca
+test_seed_refuses_wait_for_setup_before_creation
+test_seed_refuses_wrong_created_revision_with_recovery_route
+test_seed_refuses_foreign_repository_object_store
+test_recover_orca_defaults_to_nonforced_removal_without_live_terminals
+test_seed_spawn_and_safe_retire
+test_explicit_orca_adoption
