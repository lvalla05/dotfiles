+  if ! ORCA_FAKE_MODE=old-runtime run_launch start >/dev/null 2>&1 \
+    && ! grep '^terminal create ' "$FAKE_LOG" >/dev/null \
+    && [ ! -e "$CASE_DIR/home/state/.afk" ] \
+    && [ ! -e "$CASE_DIR/home/state/.afk-daemon-terminal" ]; then
+    pass "Orca old runtime: missing live tuple support refuses before state or terminal creation"
+  else
+    fail "Orca old runtime: unsupported terminal identity was allowed to mutate lifecycle state"
+  fi
