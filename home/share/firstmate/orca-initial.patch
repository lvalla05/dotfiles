+    && run_launch reconcile >/dev/null 2>&1 \
+    && [ ! -e "$FAKE_ALIVE" ] \
+    && [ ! -e "$CASE_DIR/home/state/.afk-daemon-terminal" ]; then
+    pass "Orca crash reconciliation: closes the recorded dead-daemon tab by exact identity"
+  else
+    fail "Orca crash reconciliation: leaked or discarded the recorded terminal"
+  fi
+}
+
+test_orca_stop_accepts_authoritative_disconnected_terminal() {
+  make_case
+  if run_launch start >/dev/null 2>&1 \
+    && ORCA_FAKE_CLOSED_SHOW_DISCONNECTED=1 run_launch stop >/dev/null 2>&1 \
+    && [ ! -e "$FAKE_ALIVE" ] \
+    && [ ! -e "$CASE_DIR/home/state/.afk-daemon-terminal" ] \
+    && [ ! -e "$CASE_DIR/home/state/.afk-orca-primary-process" ]; then
+    pass "Orca stop: connected=false and writable=false prove a successfully closed terminal absent"
+  else
+    fail "Orca stop: preserved lifecycle state after authoritative disconnected terminal proof"
+  fi
+}
+
+test_orca_reconcile_accepts_terminal_that_exited_before_close() {
+  make_case
+  if run_launch start >/dev/null 2>&1; then
+    rm -f "$FAKE_ALIVE"
+  fi
+  : > "$FAKE_LOG"
+  if ORCA_FAKE_CLOSED_SHOW_DISCONNECTED=1 run_launch reconcile >/dev/null 2>&1 \
+    && [ ! -e "$CASE_DIR/home/state/.afk-daemon-terminal" ] \
+    && [ ! -e "$CASE_DIR/home/state/.afk-orca-primary-process" ] \
+    && ! grep '^terminal close ' "$FAKE_LOG" >/dev/null; then
+    pass "Orca reconcile: a daemon tab that exited before close is authoritatively absent"
+  else
+    fail "Orca reconcile: attempted stale recovery or close after authoritative disconnected proof"
+  fi
+}
+
+test_orca_old_runtime_refuses_before_create() {
