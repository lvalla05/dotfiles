+test_orca_daemon_record_remint_is_atomic() {
+  local record lists
+  make_case
+  run_launch start >/dev/null 2>&1 || { fail "Orca daemon remint setup failed"; return; }
+  : > "$FAKE_LOG"
+  if ! ORCA_FAKE_MODE=daemon-remint ORCA_FAKE_CLOSE_FAIL=1 run_launch reconcile >/dev/null 2>&1; then
+    record=$(cat "$CASE_DIR/home/state/.afk-daemon-terminal" 2>/dev/null || true)
+    lists=$(grep -c '^terminal list ' "$FAKE_LOG" 2>/dev/null || true)
+    if [ "$(printf '%s' "$record" | cut -f2)" = term-daemon-remint ] \
+      && [ "$lists" -eq 2 ] && [ -e "$FAKE_ALIVE" ]; then
+      pass "Orca daemon remint: atomically records the exact replacement before a close attempt"
+    else
+      fail "Orca daemon remint: replacement identity was not durably published"
+    fi
