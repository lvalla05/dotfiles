+fm_orca_process_agent_state_from_meta() {  # <meta> <terminal>
+  local meta=$1 target=$2 state task binding schema backend terminal spawn_gen worktree_id worktree_path
+  local facts key current shell_pid shell_birth shell_tty birth tty cwd ps_bin rows
+  local pid pgid tpgid comm args argv0 class fg_count=0 exact_shell=0 other=0
+  state=$(dirname "$meta")
+  task=$(fm_orca_process_record_get "$meta" endpoint_task_id 2>/dev/null) || { printf 'unreadable'; return 0; }
+  fm_orca_process_task_id_valid "$task" || { printf 'unreadable'; return 0; }
+  binding="$state/$task.orca-process"
+  [ -f "$binding" ] || { printf 'unverified'; return 0; }
+  backend=$(fm_orca_process_record_get "$meta" backend 2>/dev/null) || { printf 'unreadable'; return 0; }
+  terminal=$(fm_orca_process_record_get "$meta" terminal 2>/dev/null) || { printf 'unreadable'; return 0; }
+  spawn_gen=$(fm_orca_process_record_get "$meta" spawn_gen 2>/dev/null) || { printf 'unreadable'; return 0; }
+  worktree_id=$(fm_orca_process_record_get "$meta" orca_worktree_id 2>/dev/null) || { printf 'unreadable'; return 0; }
+  worktree_path=$(fm_orca_process_record_get "$meta" worktree 2>/dev/null) || { printf 'unreadable'; return 0; }
+  [ "$backend" = orca ] && [ "$terminal" = "$target" ] || { printf 'unreadable'; return 0; }
+  schema=$(fm_orca_process_record_get "$binding" schema 2>/dev/null) || { printf 'unreadable'; return 0; }
+  [ "$schema" = fm-orca-process.v1 ] \
+    && [ "$(fm_orca_process_record_get "$binding" task_id 2>/dev/null)" = "$task" ] \
+    && [ "$(fm_orca_process_record_get "$binding" spawn_gen 2>/dev/null)" = "$spawn_gen" ] \
+    && [ "$(fm_orca_process_record_get "$binding" terminal 2>/dev/null)" = "$terminal" ] \
+    && [ "$(fm_orca_process_record_get "$binding" worktree_id 2>/dev/null)" = "$worktree_id" ] \
+    && [ "$(fm_orca_process_record_get "$binding" worktree_path 2>/dev/null)" = "$worktree_path" ] \
+    && [ "$(fm_orca_process_record_get "$binding" execution_host_id 2>/dev/null)" = local ] \
+    || { printf 'unreadable'; return 0; }
+
+  facts=$(fm_orca_process_terminal_facts "$target") || { printf 'unreadable'; return 0; }
+  for key in terminal worktree_id worktree_path pty_id incarnation_id tab_id leaf_id execution_host_id; do
+    current=$(fm_orca_process_text_get "$facts" "$key" 2>/dev/null) || { printf 'unreadable'; return 0; }
+    [ "$current" = "$(fm_orca_process_record_get "$binding" "$key" 2>/dev/null)" ] \
+      || { printf 'unreadable'; return 0; }
+  done
+
+  shell_pid=$(fm_orca_process_record_get "$binding" shell_pid 2>/dev/null) || { printf 'unreadable'; return 0; }
+  shell_birth=$(fm_orca_process_record_get "$binding" shell_birth 2>/dev/null) || { printf 'unreadable'; return 0; }
+  shell_tty=$(fm_orca_process_record_get "$binding" shell_tty 2>/dev/null) || { printf 'unreadable'; return 0; }
+  case "$shell_pid" in ''|*[!0-9]*|0|1) printf 'unreadable'; return 0 ;; esac
+  birth=$(fm_orca_process_ps_field "$shell_pid" lstart) || { printf 'unreadable'; return 0; }
+  tty=$(fm_orca_process_ps_field "$shell_pid" tty) || { printf 'unreadable'; return 0; }
+  tty=$(fm_orca_process_tty_normalize "$tty") || { printf 'unreadable'; return 0; }
+  [ "$birth" = "$shell_birth" ] && [ "$tty" = "$shell_tty" ] || { printf 'unreadable'; return 0; }
+  cwd=$(fm_orca_process_pid_cwd "$shell_pid") || { printf 'unreadable'; return 0; }
+  [ "$cwd" = "$worktree_path" ] || { printf 'unreadable'; return 0; }
+
+  fm_orca_process_load_classifier || { printf 'unreadable'; return 0; }
+  ps_bin=${FM_ORCA_PS_BIN:-ps}
+  rows=$(LC_ALL=C "$ps_bin" -t "${shell_tty#/dev/}" -o pid=,pgid=,tpgid=,comm= 2>/dev/null) \
+    || { printf 'unreadable'; return 0; }
+  while read -r pid pgid tpgid comm; do
+    [ -n "$pid" ] && [ -n "$comm" ] && [ "$pgid" = "$tpgid" ] || continue
+    fg_count=$((fg_count + 1))
+    args=$(fm_orca_process_ps_field "$pid" args 2>/dev/null || true)
+    argv0=${args%%[[:space:]]*}
+    class=$(fm_backend_tmux_classify_process_name "$comm" "$argv0")
+    if [ "$class" = agent ] || { [ -n "$args" ] && fm_gemini_args_are_gemini "$args"; }; then
+      printf 'alive'
+      return 0
+    fi
+    if [ "$pid" = "$shell_pid" ] && [ "$class" = shell ]; then
+      exact_shell=$((exact_shell + 1))
+    else
+      other=1
+    fi
+  done <<EOF
+$rows
+EOF
+  if [ "$fg_count" -eq 1 ] && [ "$exact_shell" -eq 1 ] && [ "$other" -eq 0 ]; then
+    printf 'dead'
+  elif [ "$fg_count" -eq 0 ]; then
+    printf 'unreadable'
+  else
+    printf 'ambiguous'
+  fi
+}
