+test_orca_daemon_remint_refuses_zero_or_multiple() {
+  local mode
+  for mode in daemon-no-match daemon-multiple; do
+    make_case
+    run_launch start >/dev/null 2>&1 || { fail "Orca $mode setup failed"; continue; }
+    : > "$FAKE_LOG"
+    if ! ORCA_FAKE_MODE=$mode run_launch reconcile >/dev/null 2>&1 \
+      && [ "$(cut -f2 "$CASE_DIR/home/state/.afk-daemon-terminal")" = term-daemon ] \
+      && [ -e "$FAKE_ALIVE" ] \
+      && ! grep '^terminal close ' "$FAKE_LOG" >/dev/null; then
+      pass "Orca daemon remint: $mode preserves the old record and refuses teardown"
+    else
+      fail "Orca daemon remint: $mode did not fail closed"
+    fi
+  done
+}
