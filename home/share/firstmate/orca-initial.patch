new file mode 100755
index 0000000..6ef0df2
--- /dev/null
+++ b/bin/fm-orca-process-lib.sh
@@ -0,0 +1,855 @@
+#!/usr/bin/env bash
+# fm-orca-process-lib.sh - recovery-grade local process binding for Orca.
+#
+# Orca exposes stable terminal metadata but no process-liveness verdict. A
+# launch-time binder therefore records the interactive shell that owns the
+# exact task terminal. Passive readers revalidate both identities and inspect
+# only that tty's foreground process group. The sole bound shell is dead, a
+# verified harness is alive, and every contradiction or foreign process is
+# fail-closed (unreadable or ambiguous).
+
+FM_ORCA_PROCESS_SCRIPT=${BASH_SOURCE[0]:-$0}
+FM_ORCA_PROCESS_BIN_DIR="$(cd "$(dirname "$FM_ORCA_PROCESS_SCRIPT")" && pwd)"
+unset FM_ORCA_PROCESS_SCRIPT
+
+fm_orca_process_record_get() {  # <file> <key>
+  local file=$1 key=$2 line value found=0
+  [ -f "$file" ] || return 1
+  while IFS= read -r line || [ -n "$line" ]; do
+    case "$line" in
+      "$key="*)
+        [ "$found" -eq 0 ] || return 2
+        value=${line#*=}
+        found=1
+        ;;
+    esac
+  done < "$file"
+  [ "$found" -eq 1 ] || return 1
+  printf '%s' "$value"
+}
+
+fm_orca_process_text_get() {  # <text> <key>
+  local text=$1 key=$2 line value found=0
+  while IFS= read -r line || [ -n "$line" ]; do
+    case "$line" in
+      "$key="*)
+        [ "$found" -eq 0 ] || return 2
+        value=${line#*=}
+        found=1
+        ;;
+    esac
+  done <<EOF
+$text
+EOF
+  [ "$found" -eq 1 ] || return 1
+  printf '%s' "$value"
+}
+
+fm_orca_process_value_safe() {  # <value>, nonempty and one printable line
+  local value=${1-}
+  [ -n "$value" ] || return 1
+  case "$value" in
+    *[$'\001'-$'\037'$'\177']*) return 1 ;;
+  esac
+}
+
+fm_orca_process_task_id_valid() {
+  case "${1-}" in
+    ''|.*|*[!A-Za-z0-9._-]*|*..*) return 1 ;;
+  esac
+  return 0
+}
+
+fm_orca_process_shell_quote() {  # <one-line value>
+  local value=${1-} escaped
+  fm_orca_process_value_safe "$value" || return 1
+  escaped=${value//\'/\'\\\'\'}
+  printf "'%s'" "$escaped"
+}
+
+fm_orca_process_terminal_facts() {  # <terminal handle>
+  local terminal=$1 out cli=${FM_ORCA_CLI_BIN:-orca}
+  out=$("$cli" terminal show --terminal "$terminal" --json 2>/dev/null) || return 1
+  # shellcheck disable=SC2016  # JavaScript template interpolation is literal shell input.
+  printf '%s' "$out" | node -e '
+const fs = require("fs");
+let data;
+try { data = JSON.parse(fs.readFileSync(0, "utf8")); } catch { process.exit(1); }
+if (!data || data.ok === false) process.exit(1);
+const t = data.result && data.result.terminal;
+if (!t || typeof t !== "object" || t.orphaned === true || t.connected === false || t.writable === false) process.exit(1);
+const fields = [
+  ["terminal", t.handle], ["pty_id", t.ptyId],
+  ["incarnation_id", t.incarnationId], ["worktree_id", t.worktreeId],
+  ["worktree_path", t.worktreePath], ["tab_id", t.tabId],
+  ["leaf_id", t.leafId], ["execution_host_id", t.executionHostId]
+];
+for (const [key, value] of fields) {
+  if (typeof value !== "string" || !value || /[\u0000-\u001f\u007f]/u.test(value)) process.exit(1);
+  process.stdout.write(`${key}=${value}\n`);
+}
+' || return 1
+}
+
+fm_orca_process_ps_field() {  # <pid> <ps field>
+  local pid=$1 field=$2 ps_bin=${FM_ORCA_PS_BIN:-ps} value
+  value=$(LC_ALL=C "$ps_bin" -p "$pid" -o "$field=" 2>/dev/null) || return 1
+  value=${value#"${value%%[![:space:]]*}"}
+  value=${value%"${value##*[![:space:]]}"}
+  [ -n "$value" ] || return 1
+  printf '%s' "$value"
+}
+
+fm_orca_process_tty_normalize() {  # <ps tty or /dev path>
+  local value=${1-}
+  value=${value#"${value%%[![:space:]]*}"}
+  value=${value%"${value##*[![:space:]]}"}
+  case "$value" in
+    /dev/*) ;;
+    '?'|'??'|'') return 1 ;;
+    *) value="/dev/$value" ;;
+  esac
+  fm_orca_process_value_safe "$value" || return 1
+  printf '%s' "$value"
+}
+
+fm_orca_process_pid_cwd() {  # <pid>
+  local pid=$1 lsof_bin=${FM_ORCA_LSOF_BIN:-lsof} out line cwd='' found=0
+  out=$(LC_ALL=C "$lsof_bin" -a -p "$pid" -d cwd -Fn 2>/dev/null) || return 1
+  while IFS= read -r line || [ -n "$line" ]; do
+    case "$line" in
+      n*)
+        [ "$found" -eq 0 ] || return 1
+        cwd=${line#n}
+        found=1
+        ;;
+    esac
+  done <<EOF
+$out
+EOF
+  [ "$found" -eq 1 ] && fm_orca_process_value_safe "$cwd" || return 1
+  printf '%s' "$cwd"
+}
+
+fm_orca_process_prepare_bind_command() {  # <meta> <state-dir> <task-id>
+  local meta=$1 state=$2 task=$3 backend terminal spawn_gen exe
+  fm_orca_process_task_id_valid "$task" || return 1
+  backend=$(fm_orca_process_record_get "$meta" backend) || return 1
+  [ "$backend" = orca ] || return 1
+  terminal=$(fm_orca_process_record_get "$meta" terminal) || return 1
+  spawn_gen=$(fm_orca_process_record_get "$meta" spawn_gen) || return 1
+  [ "$(fm_orca_process_record_get "$meta" endpoint_task_id)" = "$task" ] || return 1
+  exe=${FM_ORCA_PROCESS_BINDER:-$FM_ORCA_PROCESS_BIN_DIR/fm-orca-process-lib.sh}
+  printf '%s bind --meta %s --state %s --task %s --terminal %s --spawn-gen %s --shell-pid "$$"' \
+    "$(fm_orca_process_shell_quote "$exe")" \
+    "$(fm_orca_process_shell_quote "$meta")" \
+    "$(fm_orca_process_shell_quote "$state")" \
+    "$(fm_orca_process_shell_quote "$task")" \
+    "$(fm_orca_process_shell_quote "$terminal")" \
+    "$(fm_orca_process_shell_quote "$spawn_gen")"
+}
+
+fm_orca_process_bind() {  # parsed CLI values in globals
+  local backend meta_task meta_terminal meta_gen worktree_id worktree_path
+  local facts terminal pty_id incarnation_id fact_worktree_id fact_worktree_path
+  local tab_id leaf_id execution_host_id parent observed_tty shell_tty birth cwd
+  local binding tmp old_umask tty_bin shell_comm shell_args shell_argv0
+
+  fm_orca_process_task_id_valid "$FM_ORCA_BIND_TASK" || return 1
+  [ -d "$FM_ORCA_BIND_STATE" ] && [ -f "$FM_ORCA_BIND_META" ] || return 1
+  [ "$FM_ORCA_BIND_META" = "$FM_ORCA_BIND_STATE/$FM_ORCA_BIND_TASK.meta" ] || return 1
+  backend=$(fm_orca_process_record_get "$FM_ORCA_BIND_META" backend) || return 1
+  meta_task=$(fm_orca_process_record_get "$FM_ORCA_BIND_META" endpoint_task_id) || return 1
+  meta_terminal=$(fm_orca_process_record_get "$FM_ORCA_BIND_META" terminal) || return 1
+  meta_gen=$(fm_orca_process_record_get "$FM_ORCA_BIND_META" spawn_gen) || return 1
+  worktree_id=$(fm_orca_process_record_get "$FM_ORCA_BIND_META" orca_worktree_id) || return 1
+  worktree_path=$(fm_orca_process_record_get "$FM_ORCA_BIND_META" worktree) || return 1
+  [ "$backend" = orca ] && [ "$meta_task" = "$FM_ORCA_BIND_TASK" ] \
+    && [ "$meta_terminal" = "$FM_ORCA_BIND_TERMINAL" ] \
+    && [ "$meta_gen" = "$FM_ORCA_BIND_SPAWN_GEN" ] || return 1
+
+  parent=${FM_ORCA_BIND_PARENT_PID_OVERRIDE:-$PPID}
+  case "$FM_ORCA_BIND_SHELL_PID:$parent" in
+    *[!0-9:]*|:*|*:|1:*|0:*) return 1 ;;
+  esac
+  [ "$FM_ORCA_BIND_SHELL_PID" = "$parent" ] || return 1
+  birth=$(fm_orca_process_ps_field "$FM_ORCA_BIND_SHELL_PID" lstart) || return 1
+  shell_tty=$(fm_orca_process_ps_field "$FM_ORCA_BIND_SHELL_PID" tty) || return 1
+  shell_tty=$(fm_orca_process_tty_normalize "$shell_tty") || return 1
+  shell_comm=$(fm_orca_process_ps_field "$FM_ORCA_BIND_SHELL_PID" comm) || return 1
+  shell_args=$(fm_orca_process_ps_field "$FM_ORCA_BIND_SHELL_PID" args) || return 1
+  shell_argv0=${shell_args%%[[:space:]]*}
+  fm_orca_process_load_classifier || return 1
+  [ "$(fm_backend_tmux_classify_process_name "$shell_comm" "$shell_argv0")" = shell ] || return 1
+  if [ -n "${FM_ORCA_BIND_SELF_TTY_OVERRIDE:-}" ]; then
+    observed_tty=$FM_ORCA_BIND_SELF_TTY_OVERRIDE
+  else
+    tty_bin=${FM_ORCA_TTY_BIN:-tty}
+    observed_tty=$("$tty_bin" 2>/dev/null) || return 1
+  fi
+  observed_tty=$(fm_orca_process_tty_normalize "$observed_tty") || return 1
+  [ "$shell_tty" = "$observed_tty" ] || return 1
+  cwd=$(fm_orca_process_pid_cwd "$FM_ORCA_BIND_SHELL_PID") || return 1
+  [ "$cwd" = "$worktree_path" ] || return 1
+
+  facts=$(fm_orca_process_terminal_facts "$FM_ORCA_BIND_TERMINAL") || return 1
+  terminal=$(fm_orca_process_text_get "$facts" terminal) || return 1
+  pty_id=$(fm_orca_process_text_get "$facts" pty_id) || return 1
+  incarnation_id=$(fm_orca_process_text_get "$facts" incarnation_id) || return 1
+  fact_worktree_id=$(fm_orca_process_text_get "$facts" worktree_id) || return 1
+  fact_worktree_path=$(fm_orca_process_text_get "$facts" worktree_path) || return 1
+  tab_id=$(fm_orca_process_text_get "$facts" tab_id) || return 1
+  leaf_id=$(fm_orca_process_text_get "$facts" leaf_id) || return 1
+  execution_host_id=$(fm_orca_process_text_get "$facts" execution_host_id) || return 1
+  [ "$terminal" = "$FM_ORCA_BIND_TERMINAL" ] \
+    && [ "$fact_worktree_id" = "$worktree_id" ] \
+    && [ "$fact_worktree_path" = "$worktree_path" ] \
+    && [ "$execution_host_id" = local ] || return 1
+
+  binding="$FM_ORCA_BIND_STATE/$FM_ORCA_BIND_TASK.orca-process"
+  old_umask=$(umask); umask 077
+  tmp=$(mktemp "$FM_ORCA_BIND_STATE/.${FM_ORCA_BIND_TASK}.orca-process.XXXXXX") || { umask "$old_umask"; return 1; }
+  umask "$old_umask"
+  if ! {
+    printf 'schema=fm-orca-process.v1\n'
+    printf 'task_id=%s\n' "$FM_ORCA_BIND_TASK"
+    printf 'spawn_gen=%s\n' "$FM_ORCA_BIND_SPAWN_GEN"
+    printf 'terminal=%s\n' "$terminal"
+    printf 'worktree_id=%s\n' "$fact_worktree_id"
+    printf 'worktree_path=%s\n' "$fact_worktree_path"
+    printf 'pty_id=%s\n' "$pty_id"
+    printf 'incarnation_id=%s\n' "$incarnation_id"
+    printf 'tab_id=%s\n' "$tab_id"
+    printf 'leaf_id=%s\n' "$leaf_id"
+    printf 'execution_host_id=%s\n' "$execution_host_id"
+    printf 'shell_pid=%s\n' "$FM_ORCA_BIND_SHELL_PID"
+    printf 'shell_birth=%s\n' "$birth"
+    printf 'shell_tty=%s\n' "$shell_tty"
+  } > "$tmp"; then
+    rm -f "$tmp"
+    return 1
+  fi
+  chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
+  mv -f "$tmp" "$binding"
+}
+
+fm_orca_process_load_classifier() {
+  local classifier_dir
+  if ! type fm_backend_tmux_classify_process_name >/dev/null 2>&1; then
+    classifier_dir=${FM_BACKEND_LIB_DIR:-$FM_ORCA_PROCESS_BIN_DIR}
+    FM_BACKEND_LIB_DIR=$classifier_dir
+    # shellcheck source=bin/backends/tmux.sh
+    . "$classifier_dir/backends/tmux.sh"
+  fi
+}
+
+# The Orca API does not expose a recovery-grade Pi identity or busy state.
+# Composer proof therefore starts from the launch binding, revalidates its
+# complete local terminal tuple and kernel owner, and then inspects only that
+# terminal's native foreground process group. Cached Orca agentIdentity text is
+# deliberately not part of this decision.
+fm_orca_process_pi_process_matches() {  # <comm> <args>
+  local comm=${1:-} args=${2:-} argv0 base
+  argv0=${args%%[[:space:]]*}
+  for base in "$comm" "$argv0"; do
+    base=${base##*/}
+    base=${base#-}
+    case "$base" in
+      pi|pi-signed|pi-launcher|Pi) return 0 ;;
+    esac
+  done
+  return 1
+}
+
+fm_orca_process_binding_kernel_load() {  # <binding>
+  local binding=$1 schema
+  schema=$(fm_orca_process_record_get "$binding" schema 2>/dev/null) || return 1
+  case "$schema" in
+    fm-orca-process.v1)
+      FM_ORCA_PROCESS_BOUND_PID=$(fm_orca_process_record_get "$binding" shell_pid 2>/dev/null) || return 1
+      FM_ORCA_PROCESS_BOUND_BIRTH=$(fm_orca_process_record_get "$binding" shell_birth 2>/dev/null) || return 1
+      FM_ORCA_PROCESS_BOUND_TTY=$(fm_orca_process_record_get "$binding" shell_tty 2>/dev/null) || return 1
+      ;;
+    fm-orca-supervisor-process.v1)
+      FM_ORCA_PROCESS_BOUND_PID=$(fm_orca_process_record_get "$binding" process_pid 2>/dev/null) || return 1
+      FM_ORCA_PROCESS_BOUND_BIRTH=$(fm_orca_process_record_get "$binding" process_birth 2>/dev/null) || return 1
+      FM_ORCA_PROCESS_BOUND_TTY=$(fm_orca_process_record_get "$binding" process_tty 2>/dev/null) || return 1
+      ;;
+    *) return 1 ;;
+  esac
+  FM_ORCA_PROCESS_BOUND_WORKTREE=$(fm_orca_process_record_get "$binding" worktree_path 2>/dev/null) || return 1
+  case "$FM_ORCA_PROCESS_BOUND_PID" in ''|*[!0-9]*|0|1) return 1 ;; esac
+  fm_orca_process_value_safe "$FM_ORCA_PROCESS_BOUND_BIRTH" \
+    && fm_orca_process_value_safe "$FM_ORCA_PROCESS_BOUND_TTY" \
+    && fm_orca_process_value_safe "$FM_ORCA_PROCESS_BOUND_WORKTREE"
+}
+
+fm_orca_process_supervisor_owner_pid() {  # <current-tty>
+  local observed_tty=$1 pid first candidate='' attempt=0 tty comm args class parent
+  pid=${FM_ORCA_SUPERVISOR_PARENT_PID_OVERRIDE:-$PPID}
+  first=$pid
+  while [ "$attempt" -lt 16 ]; do
+    attempt=$((attempt + 1))
+    case "$pid" in ''|*[!0-9]*|0|1) break ;; esac
+    tty=$(fm_orca_process_ps_field "$pid" tty 2>/dev/null) || break
+    tty=$(fm_orca_process_tty_normalize "$tty" 2>/dev/null) || break
+    [ "$tty" = "$observed_tty" ] || break
+    comm=$(fm_orca_process_ps_field "$pid" comm 2>/dev/null) || break
+    args=$(fm_orca_process_ps_field "$pid" args 2>/dev/null) || break
+    if fm_orca_process_pi_process_matches "$comm" "$args"; then
+      printf '%s' "$pid"
+      return 0
+    fi
+    if [ "$pid" = "$first" ]; then
+      fm_orca_process_load_classifier || return 1
+      class=$(fm_backend_tmux_classify_process_name "$comm" "${args%%[[:space:]]*}")
+      [ "$class" = shell ] && candidate=$pid
+    fi
+    parent=$(fm_orca_process_ps_field "$pid" ppid 2>/dev/null) || break
+    pid=$parent
+  done
+  [ -n "$candidate" ] || return 1
+  printf '%s' "$candidate"
+}
+
+# Enroll the exact local process that owns an Orca primary before it execs Pi,
+# or the exact Pi ancestor when /afk is invoked from Pi's bash tool. The caller
+# already captured the current-pane tuple and passes every field again so a
+# terminal change between those two reads is rejected.
+fm_orca_process_supervisor_bind() {  # <binding> <terminal> <worktree-id> <worktree-path> <pty> <incarnation> <tab> <leaf> <host>
+  [ "$#" -eq 9 ] || return 2
+  local binding=$1 terminal=$2 worktree_id=$3 worktree_path=$4 pty_id=$5
+  local incarnation_id=$6 tab_id=$7 leaf_id=$8 execution_host_id=$9
+  local facts observed_tty owner_pid birth owner_tty cwd tmp old_umask
+  [ "$execution_host_id" = local ] && [ -d "$(dirname "$binding")" ] && [ ! -d "$binding" ] || return 1
+  facts=$(fm_orca_process_terminal_facts "$terminal") || return 1
+  fm_orca_process_facts_match_tuple "$facts" "$terminal" "$worktree_id" "$worktree_path" \
+    "$pty_id" "$incarnation_id" "$tab_id" "$leaf_id" "$execution_host_id" || return 1
+  if [ -n "${FM_ORCA_SUPERVISOR_SELF_TTY_OVERRIDE:-}" ]; then
+    observed_tty=$FM_ORCA_SUPERVISOR_SELF_TTY_OVERRIDE
+  else
+    observed_tty=$(${FM_ORCA_TTY_BIN:-tty} 2>/dev/null) || return 1
+  fi
+  observed_tty=$(fm_orca_process_tty_normalize "$observed_tty") || return 1
+  owner_pid=$(fm_orca_process_supervisor_owner_pid "$observed_tty") || return 1
+  birth=$(fm_orca_process_ps_field "$owner_pid" lstart) || return 1
+  owner_tty=$(fm_orca_process_ps_field "$owner_pid" tty) || return 1
+  owner_tty=$(fm_orca_process_tty_normalize "$owner_tty") || return 1
+  cwd=$(fm_orca_process_pid_cwd "$owner_pid") || return 1
+  [ "$owner_tty" = "$observed_tty" ] && [ "$cwd" = "$worktree_path" ] || return 1
+
+  old_umask=$(umask); umask 077
+  tmp=$(mktemp "$(dirname "$binding")/.afk-orca-primary-process.XXXXXX") \
+    || { umask "$old_umask"; return 1; }
+  umask "$old_umask"
+  if ! {
+    printf 'schema=fm-orca-supervisor-process.v1\n'
+    printf 'terminal=%s\n' "$terminal"
+    printf 'worktree_id=%s\n' "$worktree_id"
+    printf 'worktree_path=%s\n' "$worktree_path"
+    printf 'pty_id=%s\n' "$pty_id"
+    printf 'incarnation_id=%s\n' "$incarnation_id"
+    printf 'tab_id=%s\n' "$tab_id"
+    printf 'leaf_id=%s\n' "$leaf_id"
+    printf 'execution_host_id=%s\n' "$execution_host_id"
+    printf 'process_pid=%s\n' "$owner_pid"
+    printf 'process_birth=%s\n' "$birth"
+    printf 'process_tty=%s\n' "$owner_tty"
+  } > "$tmp"; then
+    rm -f "$tmp"
+    return 1
+  fi
+  chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
+  mv -f "$tmp" "$binding"
+}
+
+# Compare terminal facts with the immutable locator recorded at launch. The
+# handle is supplied separately because recovery is allowed to change that one
+# opaque name and nothing else.
+fm_orca_process_facts_match_tuple() {  # <facts> <handle> <worktree-id> <worktree-path> <pty> <incarnation> <tab> <leaf> <execution-host>
+  local facts=$1
+  shift
+  local key expected current keys='terminal worktree_id worktree_path pty_id incarnation_id tab_id leaf_id execution_host_id'
+  for key in $keys; do
+    [ "$#" -gt 0 ] || return 1
+    expected=$1
+    shift
+    fm_orca_process_value_safe "$expected" || return 1
+    current=$(fm_orca_process_text_get "$facts" "$key" 2>/dev/null) || return 1
+    [ "$current" = "$expected" ] || return 1
+  done
+  [ "$#" -eq 0 ] && [ "$expected" = local ]
+}
+
+fm_orca_process_facts_match_binding() {  # <facts> <binding> <expected-handle>
+  local facts=$1 binding=$2 expected=$3
+  local worktree_id worktree_path pty_id incarnation_id tab_id leaf_id execution_host_id
+  worktree_id=$(fm_orca_process_record_get "$binding" worktree_id) || return 1
+  worktree_path=$(fm_orca_process_record_get "$binding" worktree_path) || return 1
+  pty_id=$(fm_orca_process_record_get "$binding" pty_id) || return 1
+  incarnation_id=$(fm_orca_process_record_get "$binding" incarnation_id) || return 1
+  tab_id=$(fm_orca_process_record_get "$binding" tab_id) || return 1
+  leaf_id=$(fm_orca_process_record_get "$binding" leaf_id) || return 1
+  execution_host_id=$(fm_orca_process_record_get "$binding" execution_host_id) || return 1
+  fm_orca_process_facts_match_tuple "$facts" "$expected" \
+    "$worktree_id" "$worktree_path" "$pty_id" "$incarnation_id" \
+    "$tab_id" "$leaf_id" "$execution_host_id"
+}
+
+# Revalidate the saved interactive shell against native kernel evidence. PID,
+# birth time, tty, and cwd all have to agree; PID existence alone is never an
+# identity proof because a recycled PID could belong to an unrelated process.
+fm_orca_process_saved_kernel_valid() {  # <binding>
+  local binding=$1 birth tty cwd
+  fm_orca_process_binding_kernel_load "$binding" || return 1
+  birth=$(fm_orca_process_ps_field "$FM_ORCA_PROCESS_BOUND_PID" lstart) || return 1
+  tty=$(fm_orca_process_ps_field "$FM_ORCA_PROCESS_BOUND_PID" tty) || return 1
+  tty=$(fm_orca_process_tty_normalize "$tty") || return 1
+  cwd=$(fm_orca_process_pid_cwd "$FM_ORCA_PROCESS_BOUND_PID") || return 1
+  [ "$birth" = "$FM_ORCA_PROCESS_BOUND_BIRTH" ] \
+    && [ "$tty" = "$FM_ORCA_PROCESS_BOUND_TTY" ] \
+    && [ "$cwd" = "$FM_ORCA_PROCESS_BOUND_WORKTREE" ]
+}
+
+fm_orca_process_composer_binding_valid() {  # <binding> <terminal> [task-meta]
+  local binding=$1 terminal=$2 meta=${3:-} schema lines mode state task harness facts
+  [ -f "$binding" ] && [ ! -L "$binding" ] || return 1
+  mode=$(fm_orca_process_file_mode "$binding" 2>/dev/null) || return 1
+  [ "$mode" = 600 ] || return 1
+  schema=$(fm_orca_process_record_get "$binding" schema 2>/dev/null) || return 1
+  case "$schema" in
+    fm-orca-process.v1)
+      [ -n "$meta" ] || return 1
+      state=$(dirname "$meta")
+      task=$(fm_orca_process_record_get "$meta" endpoint_task_id 2>/dev/null) || return 1
+      [ "$(fm_orca_process_recovery_binding "$meta" "$state" "$task" 2>/dev/null)" = "$binding" ] || return 1
+      harness=$(fm_orca_process_record_get "$meta" harness 2>/dev/null) || return 1
+      case "$harness" in pi|pi-signed) ;; *) return 1 ;; esac
+      ;;
+    fm-orca-supervisor-process.v1)
+      [ -z "$meta" ] || return 1
+      lines=$(wc -l < "$binding" 2>/dev/null | tr -d '[:space:]') || return 1
+      [ "$lines" = 12 ] \
+        && [ "$(fm_orca_process_record_get "$binding" execution_host_id 2>/dev/null)" = local ] \
+        || return 1
+      ;;
+    *) return 1 ;;
+  esac
+  [ "$(fm_orca_process_record_get "$binding" terminal 2>/dev/null)" = "$terminal" ] || return 1
+  facts=$(fm_orca_process_terminal_facts "$terminal") || return 1
+  fm_orca_process_facts_match_binding "$facts" "$binding" "$terminal" || return 1
+  fm_orca_process_saved_kernel_valid "$binding"
+}
+
+fm_orca_process_foreground_pi_from_binding() {  # <binding> <terminal> [task-meta]
+  local binding=$1 terminal=$2 meta=${3:-} ps_bin rows pid pgid tpgid comm args
+  local matched=0
+  fm_orca_process_composer_binding_valid "$binding" "$terminal" "$meta" || return 1
+  fm_orca_process_binding_kernel_load "$binding" || return 1
+  ps_bin=${FM_ORCA_PS_BIN:-ps}
+  rows=$(LC_ALL=C "$ps_bin" -t "${FM_ORCA_PROCESS_BOUND_TTY#/dev/}" \
+    -o pid=,pgid=,tpgid=,comm= 2>/dev/null) || return 1
+  while read -r pid pgid tpgid comm; do
+    [ "$pid" = "$FM_ORCA_PROCESS_BOUND_PID" ] || continue
+    [ -n "$comm" ] && [ "$pgid" = "$tpgid" ] && [ "$matched" -eq 0 ] || return 1
+    args=$(fm_orca_process_ps_field "$pid" args 2>/dev/null) || return 1
+    fm_orca_process_pi_process_matches "$comm" "$args" || return 1
+    matched=1
+  done <<EOF
+$rows
+EOF
+  [ "$matched" -eq 1 ] || return 1
+  printf 'pi'
+}
+
+fm_orca_process_composer_identity_from_binding() {  # <binding> <terminal> <screen> [task-meta]
+  local binding=$1 terminal=$2 screen=$3 meta=${4:-}
+  fm_orca_process_foreground_pi_from_binding "$binding" "$terminal" "$meta" >/dev/null || return 1
+  fm_orca_process_load_classifier || return 1
+  if printf '%s' "$screen" | awk 'NF { row[++n]=$0 } END { first=n-11; if (first < 1) first=1; for (i=first; i<=n; i++) print row[i] }' \
+      | fm_busy_lines_match pi; then
+    printf 'pi\tworking'
+  else
+    printf 'pi\tidle'
+  fi
+}
+
+# Validate the two durable records before recovery consults Orca. The helper
+# intentionally accepts a stale terminal handle, but every other identity is
+# exact and both files must be ordinary files. Output is the binding path.
+fm_orca_process_recovery_binding() {  # <meta> <state-dir> <task-id>
+  local meta=$1 state=$2 task=$3 binding backend terminal spawn_gen worktree_id worktree_path
+  local schema key value embedded_path
+  fm_orca_process_task_id_valid "$task" || return 1
+  [ "$meta" = "$state/$task.meta" ] \
+    && [ -f "$meta" ] && [ ! -L "$meta" ] || return 1
+  binding="$state/$task.orca-process"
+  [ -f "$binding" ] && [ ! -L "$binding" ] || return 1
+
+  backend=$(fm_orca_process_record_get "$meta" backend) || return 1
+  terminal=$(fm_orca_process_record_get "$meta" terminal) || return 1
+  spawn_gen=$(fm_orca_process_record_get "$meta" spawn_gen) || return 1
+  worktree_id=$(fm_orca_process_record_get "$meta" orca_worktree_id) || return 1
+  worktree_path=$(fm_orca_process_record_get "$meta" worktree) || return 1
+  [ "$backend" = orca ] \
+    && [ "$(fm_orca_process_record_get "$meta" endpoint_task_id 2>/dev/null)" = "$task" ] \
+    && [ "$(fm_orca_process_record_get "$meta" window 2>/dev/null)" = "fm-$task" ] \
+    || return 1
+  for value in "$terminal" "$spawn_gen" "$worktree_id" "$worktree_path"; do
+    fm_orca_process_value_safe "$value" || return 1
+  done
+  case "$worktree_id" in *::*) embedded_path=${worktree_id#*::} ;; *) return 1 ;; esac
+  [ "$embedded_path" = "$worktree_path" ] || return 1
+
+  schema=$(fm_orca_process_record_get "$binding" schema) || return 1
+  [ "$schema" = fm-orca-process.v1 ] \
+    && [ "$(fm_orca_process_record_get "$binding" task_id 2>/dev/null)" = "$task" ] \
+    && [ "$(fm_orca_process_record_get "$binding" spawn_gen 2>/dev/null)" = "$spawn_gen" ] \
+    && [ "$(fm_orca_process_record_get "$binding" terminal 2>/dev/null)" = "$terminal" ] \
+    && [ "$(fm_orca_process_record_get "$binding" worktree_id 2>/dev/null)" = "$worktree_id" ] \
+    && [ "$(fm_orca_process_record_get "$binding" worktree_path 2>/dev/null)" = "$worktree_path" ] \
+    && [ "$(fm_orca_process_record_get "$binding" execution_host_id 2>/dev/null)" = local ] \
+    || return 1
+  for key in pty_id incarnation_id tab_id leaf_id shell_pid shell_birth shell_tty; do
+    value=$(fm_orca_process_record_get "$binding" "$key") || return 1
+    fm_orca_process_value_safe "$value" || return 1
+  done
+  printf '%s' "$binding"
+}
+
+# Read one complete worktree inventory and identify the sole terminal whose
+# full saved locator matches. This is the one-read primitive used twice by the
+# public pure resolver below.
+fm_orca_process_inventory_replacement() {  # <old> <worktree-id> <worktree-path> <pty> <incarnation> <tab> <leaf> <execution-host>
+  [ "$#" -eq 8 ] || return 2
+  local old=$1 worktree_id=$2 worktree_path=$3 pty_id=$4 incarnation_id=$5
+  local tab_id=$6 leaf_id=$7 execution_host_id=$8
+  local cli=${FM_ORCA_CLI_BIN:-orca} out list_status embedded_path value
+  [ "$execution_host_id" = local ] || return 1
+  for value in "$old" "$worktree_id" "$worktree_path" "$pty_id" "$incarnation_id" "$tab_id" "$leaf_id" "$execution_host_id"; do
+    fm_orca_process_value_safe "$value" || return 1
+  done
+  case "$worktree_id" in *::*) embedded_path=${worktree_id#*::} ;; *) return 1 ;; esac
+  [ "$embedded_path" = "$worktree_path" ] || return 1
+  out=$("$cli" terminal list --worktree "id:$worktree_id" --limit 1000 \
+    --include-visual-layouts --json 2>/dev/null) || {
+      echo "error: Orca terminal inventory could not be read completely" >&2
+      return 1
+    }
+  # shellcheck disable=SC2016  # JavaScript template interpolation is literal shell input.
+  if printf '%s' "$out" | node -e '
+const fs = require("fs");
+const [old, worktreeId, worktreePath, ptyId, incarnationId, tabId, leafId, executionHostId] = process.argv.slice(1);
+let data;
+try { data = JSON.parse(fs.readFileSync(0, "utf8")); } catch { process.exit(20); }
+const r = data && data.result;
+if (!data || data.ok === false || !r || !Array.isArray(r.terminals)) process.exit(20);
+if (r.truncated !== false || !Number.isInteger(r.totalCount) || r.totalCount !== r.terminals.length) process.exit(21);
+if (!r.hostScope || !Array.isArray(r.hostScope.omittedHostIds) || r.hostScope.omittedHostIds.length !== 0) process.exit(21);
+const valid = t => t && typeof t === "object"
+  && [t.handle, t.ptyId, t.incarnationId, t.worktreeId, t.worktreePath, t.tabId, t.leafId, t.executionHostId]
+    .every(v => typeof v === "string" && v.length > 0 && !/[\u0000-\u001f\u007f]/u.test(v));
+if (!r.terminals.every(valid)) process.exit(20);
+if (r.terminals.some(t => t.handle === old)) process.exit(22);
+const matches = r.terminals.filter(t => t.orphaned !== true
+  && t.connected !== false
+  && t.writable !== false
+  && t.handle !== old
+  && t.worktreeId === worktreeId
+  && t.worktreePath === worktreePath
+  && t.ptyId === ptyId
+  && t.incarnationId === incarnationId
+  && t.tabId === tabId
+  && t.leafId === leafId
+  && t.executionHostId === executionHostId);
+if (matches.length !== 1) process.exit(23);
+process.stdout.write(matches[0].handle);
+' "$old" "$worktree_id" "$worktree_path" "$pty_id" "$incarnation_id" "$tab_id" "$leaf_id" "$execution_host_id"; then
+    return 0
+  else
+    list_status=$?
+  fi
+  case "$list_status" in
+    0) return 0 ;;
+    21) echo "error: Orca terminal inventory was partial or omitted a host" >&2 ;;
+    22) echo "error: the stale Orca terminal handle is still present in the complete inventory" >&2 ;;
+    23) echo "error: complete Orca inventory did not contain exactly one full-locator replacement" >&2 ;;
+    *) echo "error: Orca terminal inventory was malformed" >&2 ;;
+  esac
+  return 1
+}
+
+# Pure, read-only stale-handle resolver shared by task recovery and other Orca
+# lifecycle owners. It reads two complete inventories and freshly shows the
+# same sole full-tuple candidate after each read. It never reads or writes task
+# records and prints only the replacement handle on success.
+fm_orca_process_resolve_replacement_handle() {  # <old> <worktree-id> <worktree-path> <pty> <incarnation> <tab> <leaf> <execution-host>
+  [ "$#" -eq 8 ] || return 2
+  local old=$1 worktree_id=$2 worktree_path=$3 pty_id=$4 incarnation_id=$5
+  local tab_id=$6 leaf_id=$7 execution_host_id=$8 candidate confirm facts
+  candidate=$(fm_orca_process_inventory_replacement "$old" "$worktree_id" "$worktree_path" \
+    "$pty_id" "$incarnation_id" "$tab_id" "$leaf_id" "$execution_host_id") || return 1
+  facts=$(fm_orca_process_terminal_facts "$candidate") || {
+    echo "error: replacement Orca terminal could not be freshly inspected" >&2
+    return 1
+  }
+  fm_orca_process_facts_match_tuple "$facts" "$candidate" "$worktree_id" "$worktree_path" \
+    "$pty_id" "$incarnation_id" "$tab_id" "$leaf_id" "$execution_host_id" || {
+      echo "error: replacement Orca terminal changed or mismatched the saved full locator" >&2
+      return 1
+    }
+  confirm=$(fm_orca_process_inventory_replacement "$old" "$worktree_id" "$worktree_path" \
+    "$pty_id" "$incarnation_id" "$tab_id" "$leaf_id" "$execution_host_id") || return 1
+  [ "$confirm" = "$candidate" ] || {
+    echo "error: Orca replacement identity changed during recovery validation" >&2
+    return 1
+  }
+  facts=$(fm_orca_process_terminal_facts "$candidate") || return 1
+  fm_orca_process_facts_match_tuple "$facts" "$candidate" "$worktree_id" "$worktree_path" \
+    "$pty_id" "$incarnation_id" "$tab_id" "$leaf_id" "$execution_host_id" || {
+      echo "error: Orca replacement identity changed during final fresh inspection" >&2
+      return 1
+    }
+  printf '%s' "$candidate"
+}
+
+# Binding-shaped compatibility wrapper for callers that already own a task
+# process record. New non-task owners should call the direct tuple API above.
+fm_orca_process_find_exact_replacement() {  # <binding> <old-handle>
+  local binding=$1 old=$2 worktree_id worktree_path pty_id incarnation_id tab_id leaf_id execution_host_id
+  worktree_id=$(fm_orca_process_record_get "$binding" worktree_id) || return 1
+  worktree_path=$(fm_orca_process_record_get "$binding" worktree_path) || return 1
+  pty_id=$(fm_orca_process_record_get "$binding" pty_id) || return 1
+  incarnation_id=$(fm_orca_process_record_get "$binding" incarnation_id) || return 1
+  tab_id=$(fm_orca_process_record_get "$binding" tab_id) || return 1
+  leaf_id=$(fm_orca_process_record_get "$binding" leaf_id) || return 1
+  execution_host_id=$(fm_orca_process_record_get "$binding" execution_host_id) || return 1
+  fm_orca_process_resolve_replacement_handle "$old" "$worktree_id" "$worktree_path" \
+    "$pty_id" "$incarnation_id" "$tab_id" "$leaf_id" "$execution_host_id"
+}
+
+fm_orca_process_file_mode() {  # <regular-file>
+  local mode
+  mode=$(stat -f '%Lp' "$1" 2>/dev/null) || mode=$(stat -c '%a' "$1" 2>/dev/null) || return 1
+  case "$mode" in ''|*[!0-7]*) return 1 ;; esac
+  printf '%s' "$mode"
+}
+
+fm_orca_process_rewrite_key() {  # <source> <key> <value> <destination>
+  local source=$1 key=$2 value=$3 destination=$4 line found=0 mode
+  fm_orca_process_value_safe "$value" || return 1
+  mode=$(fm_orca_process_file_mode "$source") || return 1
+  : > "$destination" || return 1
+  while IFS= read -r line || [ -n "$line" ]; do
+    case "$line" in
+      "$key="*)
+        found=$((found + 1))
+        printf '%s=%s\n' "$key" "$value" >> "$destination" || return 1
+        ;;
+      *) printf '%s\n' "$line" >> "$destination" || return 1 ;;
+    esac
+  done < "$source"
+  [ "$found" -eq 1 ] || return 1
+  chmod "$mode" "$destination"
+}
+
+# Explicit stale-handle recovery. It never runs from a read path. Callers hold
+# both the lifecycle control lock and this task's metadata lock. Prints either
+# `already-current <handle>` or `recovered <old-handle> <new-handle>`.
+fm_orca_process_recover_handle() {  # <meta> <state-dir> <task-id>
+  local meta=$1 state=$2 task=$3 binding old facts candidate
+  local old_meta old_binding new_meta new_binding
+  binding=$(fm_orca_process_recovery_binding "$meta" "$state" "$task") || {
+    echo "error: Orca recovery records are missing, ambiguous, or inconsistent" >&2
+    return 1
+  }
+  old=$(fm_orca_process_record_get "$meta" terminal) || return 1
+  fm_orca_process_saved_kernel_valid "$binding" || {
+    echo "error: saved Orca shell PID, birth time, tty, or cwd no longer matches the kernel" >&2
+    return 1
+  }
+
+  if facts=$(fm_orca_process_terminal_facts "$old"); then
+    if ! fm_orca_process_facts_match_binding "$facts" "$binding" "$old"; then
+      echo "error: the recorded Orca handle now names a different terminal tuple" >&2
+      return 1
+    fi
+    fm_orca_process_saved_kernel_valid "$binding" || {
+      echo "error: saved Orca shell identity changed during recovery validation" >&2
+      return 1
+    }
+    printf 'already-current %s' "$old"
+    return 0
+  fi
+
+  candidate=$(fm_orca_process_find_exact_replacement "$binding" "$old") || return 1
+  [ "$candidate" != "$old" ] || return 1
+  fm_orca_process_saved_kernel_valid "$binding" || {
+    echo "error: saved Orca shell identity changed before recovery publication" >&2
+    return 1
+  }
+  # The shared resolver already closed the list/show race with two complete
+  # inventories and two exact shows. Revalidate both live identities once more
+  # immediately before staging durable state.
+  facts=$(fm_orca_process_terminal_facts "$candidate") || return 1
+  if ! fm_orca_process_facts_match_binding "$facts" "$binding" "$candidate" \
+      || ! fm_orca_process_saved_kernel_valid "$binding"; then
+      echo "error: Orca terminal or shell identity changed during final recovery validation" >&2
+      return 1
+  fi
+
+  old_meta=$(mktemp "$state/.$task.recover-old-meta.XXXXXX") || return 1
+  old_binding=$(mktemp "$state/.$task.recover-old-binding.XXXXXX") || {
+    rm -f "$old_meta"; return 1
+  }
+  new_meta=$(mktemp "$state/.$task.recover-new-meta.XXXXXX") || {
+    rm -f "$old_meta" "$old_binding"; return 1
+  }
+  new_binding=$(mktemp "$state/.$task.recover-new-binding.XXXXXX") || {
+    rm -f "$old_meta" "$old_binding" "$new_meta"; return 1
+  }
+  if ! cp -p "$meta" "$old_meta" \
+      || ! cp -p "$binding" "$old_binding" \
+      || ! fm_orca_process_rewrite_key "$old_meta" terminal "$candidate" "$new_meta" \
+      || ! fm_orca_process_rewrite_key "$old_binding" terminal "$candidate" "$new_binding"; then
+    rm -f "$old_meta" "$old_binding" "$new_meta" "$new_binding"
+    echo "error: could not prepare atomic Orca recovery records" >&2
+    return 1
+  fi
+  if [ ! -f "$meta" ] || [ -L "$meta" ] || [ ! -f "$binding" ] || [ -L "$binding" ] \
+      || ! cmp -s "$meta" "$old_meta" || ! cmp -s "$binding" "$old_binding"; then
+    rm -f "$old_meta" "$old_binding" "$new_meta" "$new_binding"
+    echo "error: Orca recovery records changed before publication" >&2
+    return 1
+  fi
+  if ! mv -f "$new_meta" "$meta"; then
+    rm -f "$old_meta" "$old_binding" "$new_meta" "$new_binding"
+    echo "error: Orca recovery metadata could not be published" >&2
+    return 1
+  fi
+  if [ "${FM_ORCA_RECOVER_FAIL_BINDING_PUBLISH:-0}" = 1 ] \
+      || ! mv -f "$new_binding" "$binding"; then
+    if ! mv -f "$old_meta" "$meta"; then
+      echo "error: Orca recovery publication failed and metadata rollback failed; records remain fail-closed" >&2
+    else
+      echo "error: Orca recovery binding publication failed; metadata was rolled back" >&2
+    fi
+    rm -f "$old_binding" "$new_meta" "$new_binding"
+    return 1
+  fi
+  rm -f "$old_meta" "$old_binding" "$new_meta" "$new_binding"
+  printf 'recovered %s %s' "$old" "$candidate"
