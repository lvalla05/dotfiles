--- a/tests/fm-watch-triage.test.sh
+++ b/tests/fm-watch-triage.test.sh
@@ -2046,6 +2046,70 @@ test_nonterminal_stale_paused_absorbed_then_resurfaced() {
 # A still-live agent at an external-decision gate is the disconfirming case: it
 # must surface once, while the unchanged hash must not append the same wake on
 # every watcher re-arm.
+test_orca_exited_declared_pause_uses_bound_identity() {
+  local dir state fakebin worktree out capture_file statusf window key pane_hash sig pid back
+  dir=$(make_case orca-exited-pause); state="$dir/state"; fakebin="$dir/fakebin"
+  out="$dir/watch.out"; capture_file="$dir/pane.txt"; statusf="$state/held.status"
+  worktree="$dir/worktree"; mkdir -p "$worktree"
+  window=term-mate
+  fm_write_meta "$state/held.meta" \
+    "window=fm-held" "endpoint_task_id=held" "backend=orca" \
+    "terminal=term-mate" "orca_worktree_id=wt-mate" "spawn_gen=gen-mate" \
+    "worktree=$worktree" "harness=codex" "kind=ship" "mode=no-mistakes"
+  fm_write_meta "$state/held.orca-process" \
+    "schema=fm-orca-process.v1" "task_id=held" "spawn_gen=gen-mate" \
+    "terminal=term-mate" "worktree_id=wt-mate" "worktree_path=$worktree" \
+    "pty_id=pty-mate" "incarnation_id=inc-mate" "tab_id=tab-mate" \
+    "leaf_id=leaf-mate" "execution_host_id=local" "shell_pid=4242" \
+    "shell_birth=Sun Sep  6 12:00:00 2026" "shell_tty=/dev/ttys007"
+  cat > "$fakebin/orca" <<'SH'
+#!/usr/bin/env bash
+case "$2" in
+  show) jq -n --arg wt "$ORCA_TEST_WT" '{ok:true,result:{terminal:{handle:"term-mate",ptyId:"pty-mate",incarnationId:"inc-mate",worktreeId:"wt-mate",worktreePath:$wt,tabId:"tab-mate",leafId:"leaf-mate",executionHostId:"local",orphaned:false}}}' ;;
+  read) printf '{"ok":true,"result":{"text":"shell ready"}}\n' ;;
+  *) exit 1 ;;
+esac
+SH
+  cat > "$fakebin/orca-ps" <<'SH'
+#!/usr/bin/env bash
+if [ "$1" = -t ]; then
+  if [ "${ORCA_TEST_ALIVE:-0}" = 1 ]; then printf '5252 5252 5252 codex\n'; else printf '4242 4242 4242 /bin/zsh\n'; fi
+  exit 0
+fi
+case "$4" in
+  lstart=) printf 'Sun Sep  6 12:00:00 2026\n' ;;
+  tty=) printf 'ttys007\n' ;;
+  args=) if [ "$2" = 5252 ]; then printf 'codex\n'; else printf '/bin/zsh\n'; fi ;;
+  *) exit 1 ;;
+esac
+SH
+  cat > "$fakebin/orca-lsof" <<'SH'
+#!/usr/bin/env bash
+printf 'p4242\nn%s\n' "$ORCA_TEST_WT"
