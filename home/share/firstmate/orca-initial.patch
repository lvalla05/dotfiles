+#!/usr/bin/env bash
+# fm-orca-process-lib.sh: exact local Orca process binding and state proof.
+set -u
+
+# shellcheck source=tests/lib.sh
+. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
+# shellcheck source=bin/fm-orca-process-lib.sh
+. "$ROOT/bin/fm-orca-process-lib.sh"
+# shellcheck source=bin/fm-backend.sh
+. "$ROOT/bin/fm-backend.sh"
+
+TMP_ROOT=$(fm_test_tmproot fm-orca-process)
+mkdir -p "$TMP_ROOT"
+TMP_ROOT=$(cd "$TMP_ROOT" && pwd)
+trap 'rm -rf "$TMP_ROOT"' EXIT
+
+CASE="$TMP_ROOT/case"
+STATE="$CASE/home/state"
+META="$STATE/task1.meta"
+FAKE="$CASE/fake"
+FAKEBIN="$CASE/fakebin"
+WT="$CASE/worktree"
+LIB="$ROOT/bin/fm-orca-process-lib.sh"
+mkdir -p "$STATE" "$FAKE" "$FAKEBIN" "$WT"
+
+cat > "$FAKEBIN/orca" <<'SH'
+#!/usr/bin/env bash
+[ "${FM_ORCA_ENDPOINT_UNREADABLE:-0}" = 0 ] || exit 1
+printf '%s\n' "$*" >> "$FM_ORCA_FAKE/orca.log"
+case "$1 $2" in
+  'terminal show')
+    shift 2
+    terminal=
+    while [ "$#" -gt 0 ]; do
+      if [ "$1" = --terminal ]; then shift; terminal=$1; fi
+      shift
+    done
+    [ -n "$terminal" ] && [ -f "$FM_ORCA_FAKE/terminal.$terminal.json" ] || exit 1
+    cat "$FM_ORCA_FAKE/terminal.$terminal.json"
+    ;;
+  'terminal list')
+    [ -f "$FM_ORCA_FAKE/inventory.json" ] || exit 1
+    cat "$FM_ORCA_FAKE/inventory.json"
+    ;;
+  *) exit 1 ;;
+esac
+SH
+
+cat > "$FAKEBIN/ps" <<'SH'
+#!/usr/bin/env bash
+set -u
+if [ "${1:-}" = -p ]; then
+  pid=$2
+  field=$4
+  case "$field" in
+    lstart=) file="$FM_ORCA_FAKE/birth.$pid" ;;
+    tty=) file="$FM_ORCA_FAKE/tty.$pid" ;;
+    comm=) file="$FM_ORCA_FAKE/comm.$pid" ;;
+    args=) file="$FM_ORCA_FAKE/args.$pid" ;;
+    ppid=) file="$FM_ORCA_FAKE/ppid.$pid" ;;
+    *) exit 1 ;;
+  esac
+  [ -f "$file" ] || exit 1
+  cat "$file"
+  exit 0
+fi
+if [ "${1:-}" = -t ]; then
+  cat "$FM_ORCA_FAKE/rows"
+  exit 0
+fi
+exit 1
+SH
+
+cat > "$FAKEBIN/lsof" <<'SH'
+#!/usr/bin/env bash
+set -u
+pid=
+while [ "$#" -gt 0 ]; do
+  if [ "$1" = -p ]; then shift; pid=$1; fi
+  shift
+done
+[ -n "$pid" ] && [ -f "$FM_ORCA_FAKE/cwd.$pid" ] || exit 1
+printf 'p%s\n' "$pid"
+printf 'n%s\n' "$(cat "$FM_ORCA_FAKE/cwd.$pid")"
+SH
+chmod +x "$FAKEBIN/orca" "$FAKEBIN/ps" "$FAKEBIN/lsof"
+
+export FM_ORCA_CLI_BIN="$FAKEBIN/orca"
+export FM_ORCA_PS_BIN="$FAKEBIN/ps"
+export FM_ORCA_LSOF_BIN="$FAKEBIN/lsof"
+export FM_ORCA_FAKE="$FAKE"
+export FM_ORCA_BIND_PARENT_PID_OVERRIDE=4242
+export FM_ORCA_BIND_SELF_TTY_OVERRIDE=/dev/ttys007
+
+write_terminal_handle() {  # <handle> [incarnation] [execution host] [pty] [tab] [leaf]
+  local handle=$1 incarnation=${2:-inc-1} host=${3:-local}
+  local pty=${4:-pty-1} tab=${5:-tab-1} leaf=${6:-leaf-1}
+  printf '%s\n' \
+    "{\"ok\":true,\"result\":{\"terminal\":{\"handle\":\"$handle\",\"ptyId\":\"$pty\",\"incarnationId\":\"$incarnation\",\"orphaned\":false,\"worktreeId\":\"repo-1::$WT\",\"worktreePath\":\"$WT\",\"tabId\":\"$tab\",\"leafId\":\"$leaf\",\"executionHostId\":\"$host\"}}}" \
+    > "$FAKE/terminal.$handle.json"
+}
+
+write_terminal() {  # [incarnation] [execution host]
+  write_terminal_handle term-1 "${1:-inc-1}" "${2:-local}"
+}
+
+write_inventory() {  # <handle>...
+  local comma='' handle
+  {
+    printf '{"ok":true,"result":{"terminals":['
+    for handle in "$@"; do
+      printf '%s' "$comma"
+      printf '{"handle":"%s","ptyId":"pty-1","incarnationId":"inc-1","orphaned":false,"worktreeId":"repo-1::%s","worktreePath":"%s","tabId":"tab-1","leafId":"leaf-1","executionHostId":"local"}' \
+        "$handle" "$WT" "$WT"
+      comma=,
+    done
+    printf '],"totalCount":%s,"truncated":false,"hostScope":{"hostIds":["local"],"omittedHostIds":[]}}}\n' "$#"
+  } > "$FAKE/inventory.json"
+}
+
+write_meta() {  # <spawn-gen>
+  cat > "$META" <<EOF
+window=fm-task1
+endpoint_task_id=task1
+worktree=$WT
+harness=codex
+kind=ship
+spawn_gen=$1
+backend=orca
+orca_worktree_id=repo-1::$WT
+terminal=term-1
+EOF
+}
+
+bind_current() {
+  env FM_ORCA_CLI_BIN="$FM_ORCA_CLI_BIN" FM_ORCA_PS_BIN="$FM_ORCA_PS_BIN" \
+    FM_ORCA_LSOF_BIN="$FM_ORCA_LSOF_BIN" FM_ORCA_FAKE="$FM_ORCA_FAKE" \
+    FM_ORCA_BIND_PARENT_PID_OVERRIDE=4242 FM_ORCA_BIND_SELF_TTY_OVERRIDE=/dev/ttys007 \
+    "$LIB" bind --meta "$META" --state "$STATE" --task task1 \
+      --terminal term-1 --spawn-gen "$(fm_orca_process_record_get "$META" spawn_gen)" \
+      --shell-pid 4242
+}
+
+state() {
+  fm_orca_process_agent_state_from_meta "$META" term-1
+}
+
+reset_identity() {
+  rm -f "$FAKE"/terminal.*.json "$FAKE/inventory.json" "$FAKE/orca.log"
+  : > "$FAKE/orca.log"
+  write_terminal inc-1 local
+  write_meta gen-1
+  printf 'Sun Sep  6 12:00:00 2026\n' > "$FAKE/birth.4242"
+  printf 'ttys007\n' > "$FAKE/tty.4242"
+  printf '%s\n' '-/bin/zsh' > "$FAKE/comm.4242"
+  printf '%s\n' "$WT" > "$FAKE/cwd.4242"
+  printf '/bin/zsh\n' > "$FAKE/args.4242"
+  printf '1\n' > "$FAKE/ppid.4242"
+  printf '4242 4242 4242 /bin/zsh\n' > "$FAKE/rows"
+  bind_current || fail "the exact local shell should bind"
+}
+
+recover() {
+  fm_orca_process_recover_handle "$META" "$STATE" task1
+}
+
+test_file_mode() {
+  node -e 'process.stdout.write((require("fs").statSync(process.argv[1]).mode & 0o777).toString(8))' "$1"
+}
+
+test_state_signature() {
+  node -e '
+const fs = require("fs"), path = require("path"), root = process.argv[1];
+for (const name of fs.readdirSync(root).sort()) {
+  const file = path.join(root, name), stat = fs.statSync(file);
+  if (stat.isFile()) process.stdout.write(JSON.stringify([name, stat.mode, stat.mtimeMs, stat.size, fs.readFileSync(file).toString("base64")]) + "\n");
+}' "$STATE"
+}
+
+test_prepared_command_keeps_shell_expansion_terminal_side() {
+  local command
+  reset_identity
+  command=$(fm_orca_process_prepare_bind_command "$META" "$STATE" task1) \
+    || fail "bind command preparation should succeed"
+  assert_contains "$command" '--shell-pid "$$"' \
+    "the interactive shell pid must expand inside the target terminal"
+  assert_contains "$command" "--terminal 'term-1' --spawn-gen 'gen-1'" \
+    "the command should pin the endpoint and spawn generation"
+  pass "fm-orca-process: bind command is safely prepared for the target shell"
+}
+
+test_binding_is_private_and_shell_only_is_dead() {
+  local mode verdict
+  reset_identity
+  mode=$(test_file_mode "$STATE/task1.orca-process")
+  [ "$mode" = 600 ] || fail "process binding mode should be 600, got $mode"
+  verdict=$(state)
+  [ "$verdict" = dead ] || fail "sole exact shell should be dead, got $verdict"
+  pass "fm-orca-process: exact shell-only foreground is proven dead"
+}
+
+test_known_harness_is_alive() {
+  local verdict
+  reset_identity
+  printf '/opt/homebrew/bin/codex --yolo\n' > "$FAKE/args.4300"
+  printf '4300 4300 4300 /opt/homebrew/bin/codex\n4242 4242 4300 /bin/zsh\n' > "$FAKE/rows"
+  verdict=$(state)
+  [ "$verdict" = alive ] || fail "known foreground harness should be alive, got $verdict"
+  pass "fm-orca-process: verified foreground harness is alive"
+}
+
+test_unrelated_foreground_is_ambiguous() {
+  local verdict
+  reset_identity
+  printf '/bin/sleep 30\n' > "$FAKE/args.4301"
+  printf '4301 4301 4301 /bin/sleep\n4242 4242 4301 /bin/zsh\n' > "$FAKE/rows"
+  verdict=$(state)
+  [ "$verdict" = ambiguous ] || fail "foreign foreground process should be ambiguous, got $verdict"
+  pass "fm-orca-process: unrelated foreground process is ambiguous"
+}
+
+test_pid_reuse_is_unreadable() {
+  local verdict
+  reset_identity
+  printf 'Sun Sep  6 13:00:00 2026\n' > "$FAKE/birth.4242"
+  verdict=$(state)
+  [ "$verdict" = unreadable ] || fail "reused shell pid should be unreadable, got $verdict"
+  pass "fm-orca-process: shell PID reuse never proves dead"
+}
+
+test_endpoint_mismatch_and_failure_are_unreadable() {
+  local verdict
+  reset_identity
+  write_terminal inc-2 local
+  verdict=$(state)
+  [ "$verdict" = unreadable ] || fail "changed incarnation should be unreadable, got $verdict"
+  write_terminal inc-1 local
+  verdict=$(FM_ORCA_ENDPOINT_UNREADABLE=1 state)
+  [ "$verdict" = unreadable ] || fail "failed endpoint read should be unreadable, got $verdict"
+  write_terminal inc-1 remote-host
+  verdict=$(state)
+  [ "$verdict" = unreadable ] || fail "remote host should be unreadable, got $verdict"
+  pass "fm-orca-process: endpoint contradictions fail closed"
+}
+
+test_legacy_without_binding_is_unverified() {
+  local verdict
+  reset_identity
+  rm -f "$STATE/task1.orca-process"
+  verdict=$(state)
+  [ "$verdict" = unverified ] || fail "legacy task should be unverified, got $verdict"
+  pass "fm-orca-process: legacy Orca task remains unverified"
+}
+
+test_reader_makes_no_writes() {
+  local before after verdict
+  reset_identity
+  before=$(test_state_signature)
