+#!/usr/bin/env bash
+# Opt-in live guard for launch-bound process attribution in real, nonfocused
+# Orca terminals. Every installed verified harness is launched with no prompt,
+# checked through fm-control's real current-handle no-op and exit paths, proven
+# with native ps/lsof evidence, and closed by its exact owned terminal handle.
+#
+# Standard CI has neither Orca nor vendor harnesses, so the portable contract
+# lives in fm-orca-process.test.sh. Run this guard explicitly after an Orca or
+# harness upgrade:
+#   FM_ORCA_PROCESS_LIVE=1 \
+#   FM_ORCA_PROCESS_LIVE_WORKTREE='id:<repo-id>::<absolute-path>' \
+#     bash tests/fm-orca-process-live-e2e.test.sh
+set -u
+
+if [ "${FM_ORCA_PROCESS_LIVE:-0}" != 1 ]; then
+  echo "skip: set FM_ORCA_PROCESS_LIVE=1 and FM_ORCA_PROCESS_LIVE_WORKTREE to run the real Orca process guard"
+  exit 0
+fi
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+SELECTOR=${FM_ORCA_PROCESS_LIVE_WORKTREE:-}
+[ -n "$SELECTOR" ] || {
+  echo "not ok - FM_ORCA_PROCESS_LIVE=1 requires an explicit FM_ORCA_PROCESS_LIVE_WORKTREE selector" >&2
+  exit 1
+}
+
+command -v orca >/dev/null 2>&1 || { echo "not ok - Orca CLI is not installed" >&2; exit 1; }
+command -v node >/dev/null 2>&1 || { echo "not ok - node is not installed" >&2; exit 1; }
+command -v ps >/dev/null 2>&1 || { echo "not ok - ps is not installed" >&2; exit 1; }
+command -v lsof >/dev/null 2>&1 || { echo "not ok - lsof is not installed" >&2; exit 1; }
+
+LAB=$(mktemp -d "${TMPDIR:-/tmp}/fm-orca-process-live.XXXXXX")
+STATE="$LAB/home/state"
+DATA="$LAB/home/data"
+EVIDENCE="$LAB/evidence"
+mkdir -p "$STATE" "$DATA" "$EVIDENCE"
+export FM_HOME="$LAB/home"
+export FM_STATE_OVERRIDE="$STATE"
+export FM_DATA_OVERRIDE="$DATA"
+export FM_ROOT_OVERRIDE="$ROOT"
+
+# shellcheck source=/dev/null
+. "$ROOT/bin/fm-backend.sh"
+# shellcheck source=/dev/null
+. "$ROOT/bin/fm-orca-process-lib.sh"
+# shellcheck source=/dev/null
+. "$ROOT/bin/fm-control-lib.sh"
+# shellcheck source=/dev/null
+. "$ROOT/bin/fm-cursor-lib.sh"
+fm_backend_source orca || { echo "not ok - could not load the Orca backend" >&2; exit 1; }
+
+CURRENT_HANDLE=
+# shellcheck disable=SC2329  # Invoked by the EXIT-trap cleanup chain.
+cleanup_current() {
+  if [ -n "$CURRENT_HANDLE" ]; then
+    if ! fm_backend_orca_kill "$CURRENT_HANDLE" >/dev/null 2>&1; then
+      printf 'not ok - cleanup could not confirm exact close for terminal %s; recovery evidence is preserved at %s\n' \
+        "$CURRENT_HANDLE" "$LAB" >&2
+      return 1
+    fi
+    CURRENT_HANDLE=
+  fi
+}
+# shellcheck disable=SC2329  # Invoked by on_exit.
+cleanup_all() {
+  local status=$1
+  trap - EXIT
+  if ! cleanup_current; then
+    status=1
+  fi
+  if [ -z "$CURRENT_HANDLE" ]; then
+    rm -rf "$LAB"
+  else
+    printf '# preserved live-guard recovery directory: %s\n' "$LAB" >&2
+  fi
+  exit "$status"
+}
+# shellcheck disable=SC2329  # Invoked by the EXIT trap.
+on_exit() { local status=$?; cleanup_all "$status"; }
+fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
+pass() { printf 'ok - %s\n' "$1"; }
+note() { printf '# %s\n' "$1"; }
+trap on_exit EXIT
+
+resolve_harness_binary() {  # <verified-harness>
+  local harness=$1 candidate
+  if [ "$harness" = cursor ]; then
+    fm_cursor_resolve_binary 2>/dev/null
+    return $?
+  fi
+  candidate=$(command -v "$harness" 2>/dev/null || true)
+  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
+    printf '%s\n' "$candidate"
+    return 0
+  fi
+  if [ "$harness" = kimi ] && [ -n "${HOME:-}" ] && [ -x "$HOME/.kimi-code/bin/kimi" ]; then
+    printf '%s\n' "$HOME/.kimi-code/bin/kimi"
+    return 0
+  fi
+  if [ "$harness" = rovo ] && [ -n "${HOME:-}" ] && [ -x "$HOME/.local/bin/rovo" ]; then
+    printf '%s\n' "$HOME/.local/bin/rovo"
+    return 0
+  fi
+  return 1
+}
+
+launch_line_for() {  # <harness> <binary> <worktree-path>
+  local harness=$1 binary=$2 worktree=$3 quoted quoted_wt
+  quoted=$(fm_orca_process_shell_quote "$binary") || return 1
+  quoted_wt=$(fm_orca_process_shell_quote "$worktree") || return 1
+  case "$harness" in
+    claude) printf 'CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=false CLAUDE_CODE_SEND_FEEDBACK=0 %s' "$quoted" ;;
+    pi|pi-signed) printf 'FM_PI_HARNESS=%s %s' "$harness" "$quoted" ;;
+    cursor) printf 'env -u CLAUDECODE -u PI_CODING_AGENT -u GROK_AGENT -u FM_PI_HARNESS %s --trust --workspace %s' "$quoted" "$quoted_wt" ;;
+    gemini) printf 'env -u CLAUDECODE -u PI_CODING_AGENT -u GROK_AGENT -u FM_PI_HARNESS GEMINI_CLI_TRUST_WORKSPACE=true %s -y' "$quoted" ;;
+    muse) printf 'env -u CLAUDECODE -u PI_CODING_AGENT -u GROK_AGENT -u FM_PI_HARNESS MUSE_EXPERIMENTAL_FOREIGN_PERSONAL_CONTEXT_KILL=on %s --yolo' "$quoted" ;;
+    rovo) printf 'env -u CLAUDECODE -u PI_CODING_AGENT -u GROK_AGENT -u FM_PI_HARNESS %s run --yolo' "$quoted" ;;
+    *) printf '%s' "$quoted" ;;
+  esac
+}
+
+state_signature() {  # <meta> <binding>
+  local meta=$1 binding=$2
+  stat -f '%N:%Lp:%m:%z' "$meta" "$binding"
+  cksum "$meta" "$binding"
+}
+
+terminal_absent_from_live_inventory() {  # <worktree-id> <terminal-handle>
+  local worktree_id=$1 terminal=$2 out
+  out=$(orca terminal list --worktree "id:$worktree_id" --limit 1000 \
+    --include-visual-layouts --json) || return 1
+  printf '%s' "$out" | node -e '
+const fs = require("fs");
+const terminal = process.argv[1];
+let data;
+try { data = JSON.parse(fs.readFileSync(0, "utf8")); } catch { process.exit(1); }
+const r = data && data.result;
+if (!data || data.ok === false || !r || !Array.isArray(r.terminals)) process.exit(1);
+if (r.truncated !== false || !Number.isInteger(r.totalCount) || r.totalCount !== r.terminals.length) process.exit(1);
+if (!r.hostScope || !Array.isArray(r.hostScope.omittedHostIds) || r.hostScope.omittedHostIds.length) process.exit(1);
+process.exit(r.terminals.some(t => t && t.handle === terminal) ? 1 : 0);
+' "$terminal"
+}
+
+CHECKED=0
+SKIPPED=
+
+for harness in claude codex opencode pi pi-signed grok kimi cursor gemini muse rovo; do
+  if ! bin_path=$(resolve_harness_binary "$harness"); then
+    SKIPPED="$SKIPPED $harness"
+    note "skip: $harness is not installed, so this machine supplied no real Orca evidence for that axis"
+    continue
+  fi
+  version=$("$bin_path" --version 2>/dev/null | head -1 | tr -d '\r') || version=
+  [ -n "$version" ] || version=unknown
+  task="orca-live-$harness-$$"
+  meta="$STATE/$task.meta"
+  binding="$STATE/$task.orca-process"
+
+  create_json=$(orca terminal create --worktree "$SELECTOR" \
+    --title "fm-orca-live-$harness-$$" --json) \
+    || fail "$harness $version: Orca could not create the owned nonfocused terminal"
+  CURRENT_HANDLE=$(printf '%s' "$create_json" | fm_backend_orca_json_get terminal-handle) \
+    || fail "$harness $version: terminal create returned no exact handle"
+  facts=$(fm_orca_process_terminal_facts "$CURRENT_HANDLE") \
+    || fail "$harness $version: the created terminal had no complete local identity"
+  worktree_id=$(fm_orca_process_text_get "$facts" worktree_id) || fail "$harness: missing worktree id"
+  worktree_path=$(fm_orca_process_text_get "$facts" worktree_path) || fail "$harness: missing worktree path"
+  [ "$(fm_orca_process_text_get "$facts" execution_host_id)" = local ] \
+    || fail "$harness $version: the owned terminal is not local"
+
+  cat > "$meta" <<EOF
+window=fm-$task
+endpoint_task_id=$task
+worktree=$worktree_path
+project=$worktree_path
+harness=$harness
+kind=ship
+spawn_gen=live-$$-$harness
+backend=orca
+orca_worktree_id=$worktree_id
+terminal=$CURRENT_HANDLE
+EOF
+  bind_line=$(fm_orca_process_prepare_bind_command "$meta" "$STATE" "$task") \
+    || fail "$harness $version: could not prepare the production binding command"
+  launch_line=$(launch_line_for "$harness" "$bin_path" "$worktree_path") \
+    || fail "$harness $version: could not prepare the prompt-free launch"
+  fm_backend_orca_send_text_line "$CURRENT_HANDLE" "$bind_line && $launch_line" \
+    || fail "$harness $version: prompt-free launch line was not accepted"
+
+  binding_ready=0
+  for _ in $(seq 1 100); do
+    if [ -f "$binding" ]; then binding_ready=1; break; fi
+    sleep 0.1
+  done
+  [ "$binding_ready" -eq 1 ] \
+    || fail "$harness $version: the real terminal shell did not publish its process binding"
+
+  state=
+  for _ in $(seq 1 225); do
+    state=$(fm_orca_process_agent_state_from_meta "$meta" "$CURRENT_HANDLE")
+    [ "$state" = alive ] && break
+    sleep 0.2
+  done
+  [ "$state" = alive ] \
+    || fail "$harness $version: real Orca process classified '$state', not alive"
+
+  before=$(state_signature "$meta" "$binding")
+  recover_out=$(FM_CONTROL_POLL=0.1 "$ROOT/bin/fm-control.sh" "$task" recover 2>&1) \
+    || fail "$harness $version: current-handle recover no-op failed: $recover_out"
+  after=$(state_signature "$meta" "$binding")
+  case "$recover_out" in already-current*) ;; *) fail "$harness $version: recovery overclaimed a current handle: $recover_out" ;; esac
+  [ "$before" = "$after" ] \
+    || fail "$harness $version: current-handle recovery changed metadata or binding"
+
+  shell_pid=$(fm_orca_process_record_get "$binding" shell_pid) || fail "$harness: binding omitted shell pid"
+  shell_tty=$(fm_orca_process_record_get "$binding" shell_tty) || fail "$harness: binding omitted shell tty"
+  {
+    printf 'harness=%s\nversion=%s\nterminal=%s\nshell_pid=%s\nshell_tty=%s\n' \
+      "$harness" "$version" "$CURRENT_HANDLE" "$shell_pid" "$shell_tty"
+    LC_ALL=C ps -p "$shell_pid" -o pid=,ppid=,pgid=,tpgid=,tty=,comm=,args=
+    LC_ALL=C ps -t "${shell_tty#/dev/}" -o pid=,ppid=,pgid=,tpgid=,tty=,comm=,args=
+    LC_ALL=C lsof -a -p "$shell_pid" -d cwd -Fn
+  } > "$EVIDENCE/$harness.native" \
+    || fail "$harness $version: native ps/lsof evidence could not be recorded"
+  foreground=$(LC_ALL=C ps -t "${shell_tty#/dev/}" -o pgid=,tpgid=,comm= \
+    | awk '$1 == $2 {print $3}' | tr '\n' ' ')
+  [ -n "$foreground" ] || fail "$harness $version: native tty inspection found no foreground process"
+  note "$harness $version: terminal=$CURRENT_HANDLE tty=$shell_tty foreground=[$foreground] current-recover=no-op"
+
+  exit_out=$(FM_CONTROL_POLL=0.2 FM_CONTROL_EXIT_WAIT=30 FM_CONTROL_EXIT_RETRIES=3 \
+    "$ROOT/bin/fm-control.sh" "$task" exit 2>&1) \
+    || fail "$harness $version: verified slash exit failed: $exit_out"
+  case "$exit_out" in stopped*) ;; *) fail "$harness $version: exit returned an unexpected result: $exit_out" ;; esac
+  state=$(fm_orca_process_agent_state_from_meta "$meta" "$CURRENT_HANDLE")
+  [ "$state" = dead ] || fail "$harness $version: slash exit left process state '$state'"
+
+  closed=$CURRENT_HANDLE
+  fm_backend_orca_kill "$closed" \
+    || fail "$harness $version: exact terminal close was not confirmed"
+  inventory_gone=0
+  for _ in $(seq 1 50); do
+    if terminal_absent_from_live_inventory "$worktree_id" "$closed"; then
+      inventory_gone=1
+      break
+    fi
+    sleep 0.1
+  done
+  [ "$inventory_gone" -eq 1 ] \
+    || fail "$harness $version: exact handle remained in the complete live inventory after close"
+  CURRENT_HANDLE=
+  pass "Orca process guard: $harness $version is attributable, current-recover is a no-op, slash exit is dead, and exact close is gone"
+  CHECKED=$((CHECKED + 1))
+done
+
+[ "$CHECKED" -gt 0 ] \
+  || fail "FM_ORCA_PROCESS_LIVE=1 checked zero installed harnesses; refusing a vacuous pass"
+[ -z "$SKIPPED" ] || note "unverified on this machine because not installed:$SKIPPED"
+note "checked $CHECKED installed harness(es) in owned nonfocused Orca terminals; no prompt was submitted"
+
+exit 0
