+test_secondmate_force_teardown_routes_nested_orca_home_through_orca() {
+  local home outer nested id nested_id nested_wt_id neutral out rc close_line remove_line
+  home="$TMP_ROOT/nested-orca-parent"
+  outer="$TMP_ROOT/nested-orca-outer"
+  nested="$TMP_ROOT/nested-orca-owned-home"
+  id=domain
+  nested_id=nestedorca
+  mkdir -p "$home/state" "$home/data" "$outer/state" "$outer/data" "$outer/projects" \
+    "$nested/state" "$nested/data" "$nested/config" "$nested/projects"
+  printf '%s\n' "$id" > "$outer/.fm-secondmate-home"
+  printf '%s\n' "$nested_id" > "$nested/.fm-secondmate-home"
+  write_secondmate_registry_entry "$home/data/secondmates.md" "$id" "$outer"
+  write_secondmate_registry_entry "$outer/data/secondmates.md" "$nested_id" "$nested"
+  : > "$nested/data/secondmates.md"
+  nested_wt_id=$(orca_worktree_id "$nested")
+  write_orca_secondmate_marker "$nested" "$nested_id" "$nested_wt_id"
+  fm_write_meta "$home/state/$id.meta" \
+    "window=firstmate:fm-$id" "worktree=$outer" "project=$outer" \
+    "harness=echo" "kind=secondmate" "mode=secondmate" "yolo=off" \
+    "home=$outer" "projects=none"
+  fm_write_meta "$outer/state/$nested_id.meta" \
+    "window=fm-$nested_id" "endpoint_task_id=$nested_id" "terminal=term-$nested_id" \
+    "worktree=$nested" "project=$nested" "harness=claude" "kind=secondmate" \
+    "mode=secondmate" "yolo=off" "home=$nested" "projects=none" \
+    "backend=orca" "orca_worktree_id=$nested_wt_id"
+  orca_case nested-secondmate-owned-home
+  printf '{"ok":true,"result":{"worktree":{"id":"%s","path":"%s"}}}\n' "$nested_wt_id" "$nested" > "$RESP/1.out"
+  printf '{"ok":true,"result":{"worktree":{"id":"%s","path":"%s"}}}\n' "$nested_wt_id" "$nested" > "$RESP/2.out"
+  printf '{"ok":true,"result":{"closed":true}}\n' > "$RESP/3.out"
+  printf '{"ok":true,"result":{"worktree":{"id":"%s","path":"%s"}}}\n' "$nested_wt_id" "$nested" > "$RESP/4.out"
+  printf '{"ok":true,"result":{"removed":true}}\n' > "$RESP/5.out"
+  add_tmux_fake "$FB"
+  neutral=$(neutral_fm_root "$CASE_DIR/neutral")
+  set +e
+  out=$( PATH="$FB:$PATH" FM_ORCA_LOG="$LOG" FM_ORCA_RESPONSES="$RESP" \
+    FM_ROOT_OVERRIDE="$neutral" FM_HOME="$home" "$ROOT/bin/fm-teardown.sh" "$id" --force 2>&1 )
+  rc=$?
+  set -e
+  expect_code 0 "$rc" "forced teardown should retire a nested Orca-owned secondmate through Orca"$'\n'"$out"
+  assert_contains "$(cat "$LOG")" $'orca\x1f''worktree'$'\x1f''rm'$'\x1f''--worktree'$'\x1f''id:'"$nested_wt_id"$'\x1f''--force'$'\x1f''--json' \
+    "nested Orca-owned home bypassed orca worktree rm"
+  close_line=$(grep -n $'^orca\x1fterminal\x1fclose' "$LOG" | head -1 | cut -d: -f1)
+  remove_line=$(grep -n $'^orca\x1fworktree\x1frm' "$LOG" | head -1 | cut -d: -f1)
+  [ -n "$close_line" ] && [ -n "$remove_line" ] && [ "$close_line" -lt "$remove_line" ] \
+    || fail "nested Orca retirement did not close its exact terminal before worktree removal"
+  assert_absent "$home/state/$id.meta" "successful forced teardown left the parent record"
+  pass "fm-teardown.sh --force: owner-aware Orca removal is preserved through nested secondmates"
+}
