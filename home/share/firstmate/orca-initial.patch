+test_secondmate_force_teardown_refuses_nested_orca_owner_mismatch_before_mutation() {
+  local home outer nested id nested_id nested_wt_id marker_wt_id neutral out rc
+  home="$TMP_ROOT/nested-orca-mismatch-parent"
+  outer="$TMP_ROOT/nested-orca-mismatch-outer"
+  nested="$TMP_ROOT/nested-orca-mismatch-home"
+  id=domainmismatch
+  nested_id=nestedmismatch
+  mkdir -p "$home/state" "$home/data" "$outer/state" "$outer/data" "$outer/projects" \
+    "$nested/state" "$nested/data" "$nested/config" "$nested/projects"
+  printf '%s\n' "$id" > "$outer/.fm-secondmate-home"
+  printf '%s\n' "$nested_id" > "$nested/.fm-secondmate-home"
+  write_secondmate_registry_entry "$home/data/secondmates.md" "$id" "$outer"
+  write_secondmate_registry_entry "$outer/data/secondmates.md" "$nested_id" "$nested"
+  : > "$nested/data/secondmates.md"
+  nested_wt_id=$(orca_worktree_id "$nested")
+  marker_wt_id="22222222-3333-4444-8555-666666666666::$nested"
+  write_orca_secondmate_marker "$nested" "$nested_id" "$marker_wt_id"
+  fm_write_meta "$home/state/$id.meta" \
+    "window=firstmate:fm-$id" "worktree=$outer" "project=$outer" \
+    "harness=echo" "kind=secondmate" "mode=secondmate" "yolo=off" \
+    "home=$outer" "projects=none"
+  fm_write_meta "$outer/state/$nested_id.meta" \
+    "window=fm-$nested_id" "endpoint_task_id=$nested_id" "terminal=term-$nested_id" \
+    "worktree=$nested" "project=$nested" "harness=claude" "kind=secondmate" \
+    "mode=secondmate" "yolo=off" "home=$nested" "projects=none" \
+    "backend=orca" "orca_worktree_id=$nested_wt_id"
+  orca_case nested-secondmate-owner-mismatch
+  add_tmux_fake "$FB"
+  neutral=$(neutral_fm_root "$CASE_DIR/neutral")
+  set +e
+  out=$( PATH="$FB:$PATH" FM_ORCA_LOG="$LOG" FM_ORCA_RESPONSES="$RESP" \
+    FM_ROOT_OVERRIDE="$neutral" FM_HOME="$home" "$ROOT/bin/fm-teardown.sh" "$id" --force 2>&1 )
+  rc=$?
+  set -e
+  [ "$rc" -ne 0 ] || fail "forced teardown accepted mismatched nested Orca ownership"
+  assert_contains "$out" "task metadata and persistent-home ownership name different worktrees" \
+    "nested ownership mismatch did not explain the fail-closed decision"
+  [ ! -s "$LOG" ] || fail "nested ownership mismatch mutated Orca before full-tree validation"
+  assert_present "$home/state/$id.meta" "nested ownership mismatch removed the parent record"
+  assert_present "$outer/state/$nested_id.meta" "nested ownership mismatch removed the child record"
+  assert_present "$nested/.fm-secondmate-orca" "nested ownership mismatch removed its recovery marker"
+  pass "fm-teardown.sh --force: nested Orca ownership mismatch refuses before mutation"
+}
