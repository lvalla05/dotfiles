+    && [ ! -e "$FAKE_ALIVE" ] \
+    && [ ! -e "$CASE_DIR/home/state/.afk-daemon-terminal" ]; then
+    pass "Orca daemon remint: retry closes and confirms absence by the reminted handle"
+  else
+    fail "Orca daemon remint: retry did not close the reminted exact terminal"
+  fi
