+    && [ ! -e "$CASE_DIR/home/state/.afk" ] \
+    && [ ! -e "$CASE_DIR/home/state/.afk-orca-primary-process" ]; then
+    pass "Orca stop: confirms exact terminal absence before clearing lifecycle state"
+  else
