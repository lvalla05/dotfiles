+test_real_processes_without_a_harness() (
+  local real_tmux real_sleep socket bind_command launch_command expected observed i
+  real_tmux=$(command -v tmux) || { echo "skip: tmux not found for real-process Orca regression"; exit 0; }
+  real_sleep=$(command -v sleep) || exit 1
+  command -v lsof >/dev/null || { echo "skip: lsof not found for real-process Orca regression"; exit 0; }
+  reset_identity
+  export FM_ORCA_PS_BIN FM_ORCA_LSOF_BIN
+  FM_ORCA_PS_BIN=$(command -v ps)
+  FM_ORCA_LSOF_BIN=$(command -v lsof)
+  unset FM_ORCA_BIND_PARENT_PID_OVERRIDE FM_ORCA_BIND_SELF_TTY_OVERRIDE
+  socket="fm-orca-process-${BASHPID:-$$}"
+  trap '"$real_tmux" -L "$socket" kill-server >/dev/null 2>&1 || true' EXIT
+  "$real_tmux" -L "$socket" -f /dev/null new-session -d -s native -c "$WT" \
+    /bin/bash --noprofile --norc || fail "could not create private real-process terminal"
+  rm -f "$STATE/task1.orca-process"
+  bind_command=$(fm_orca_process_prepare_bind_command "$META" "$STATE" task1) || exit 1
+  launch_command="env -u FM_ORCA_BIND_PARENT_PID_OVERRIDE -u FM_ORCA_BIND_SELF_TTY_OVERRIDE FM_ORCA_PS_BIN=$(fm_orca_process_shell_quote "$FM_ORCA_PS_BIN") FM_ORCA_LSOF_BIN=$(fm_orca_process_shell_quote "$FM_ORCA_LSOF_BIN") FM_ORCA_CLI_BIN=$(fm_orca_process_shell_quote "$FM_ORCA_CLI_BIN") FM_ORCA_FAKE=$(fm_orca_process_shell_quote "$FM_ORCA_FAKE") $bind_command"
+  "$real_tmux" -L "$socket" send-keys -t native:0 -l "$launch_command"
+  "$real_tmux" -L "$socket" send-keys -t native:0 Enter
+  for expected in dead alive dead ambiguous dead; do
+    case "$expected" in
+      alive)
+        ln -s "$real_sleep" "$WT/pi"
+        "$real_tmux" -L "$socket" send-keys -t native:0 -l "$(fm_orca_process_shell_quote "$WT/pi") 900"
+        "$real_tmux" -L "$socket" send-keys -t native:0 Enter
+        ;;
+      ambiguous)
+        ln -s "$real_sleep" "$WT/unrelated-job"
+        "$real_tmux" -L "$socket" send-keys -t native:0 -l "$(fm_orca_process_shell_quote "$WT/unrelated-job") 900"
+        "$real_tmux" -L "$socket" send-keys -t native:0 Enter
+        ;;
+    esac
+    i=0; observed=unverified
+    while [ "$i" -lt 100 ]; do
+      observed=$(state)
+      [ "$observed" != "$expected" ] || break
+      sleep 0.05
+      i=$((i + 1))
+    done
+    [ "$observed" = "$expected" ] || fail "native process evidence expected $expected, got $observed"
+    case "$expected" in alive|ambiguous) "$real_tmux" -L "$socket" send-keys -t native:0 C-c ;; esac
+  done
+  [ "$(fm_orca_process_record_get "$STATE/task1.orca-process" shell_pid)" != 4242 ] \
+    || fail "real-process case reused the mocked shell identity"
+  pass "fm-orca-process: native shell, attributed process, and unrelated foreground are distinguished without a harness"
+)
