+test_orca_secondmate_snapshot_uses_bound_process_identity() {
+  local home fakebin worktree json alive expected
+  home=$(make_home orca-bound-secondmate)
+  fakebin=$(make_fakebin "$home")
+  worktree="$home/projects/mate"
+  mkdir -p "$worktree"
+  fm_write_meta "$home/state/mate.meta" \
+    "window=fm-mate" "endpoint_task_id=mate" "backend=orca" \
+    "terminal=term-mate" "orca_worktree_id=wt-mate" "spawn_gen=gen-mate" \
+    "worktree=$worktree" "harness=codex" "kind=secondmate" "mode=secondmate"
+  fm_write_meta "$home/state/mate.orca-process" \
+    "schema=fm-orca-process.v1" "task_id=mate" "spawn_gen=gen-mate" \
+    "terminal=term-mate" "worktree_id=wt-mate" "worktree_path=$worktree" \
+    "pty_id=pty-mate" "incarnation_id=inc-mate" "tab_id=tab-mate" \
+    "leaf_id=leaf-mate" "execution_host_id=local" "shell_pid=4242" \
+    "shell_birth=Sun Sep  6 12:00:00 2026" "shell_tty=/dev/ttys007"
+  cat > "$fakebin/orca" <<'SH'
+#!/usr/bin/env bash
+[ "${ORCA_TEST_ALIVE:-0}" != unreadable ] || exit 1
+case "$2" in
+  show) jq -n --arg wt "$ORCA_TEST_WT" '{ok:true,result:{terminal:{handle:"term-mate",ptyId:"pty-mate",incarnationId:"inc-mate",worktreeId:"wt-mate",worktreePath:$wt,tabId:"tab-mate",leafId:"leaf-mate",executionHostId:"local",orphaned:false}}}' ;;
+  read) printf '{"ok":true,"result":{"text":"shell ready"}}\n' ;;
+  *) exit 1 ;;
+esac
+SH
+  cat > "$fakebin/orca-ps" <<'SH'
+#!/usr/bin/env bash
+if [ "$1" = -t ]; then
+  if [ "${ORCA_TEST_ALIVE:-0}" = 1 ]; then printf '5252 5252 5252 codex\n'; else printf '4242 4242 4242 /bin/zsh\n'; fi
+  exit 0
+fi
+case "$4" in
+  lstart=) printf 'Sun Sep  6 12:00:00 2026\n' ;;
+  tty=) printf 'ttys007\n' ;;
+  args=) if [ "$2" = 5252 ]; then printf 'codex\n'; else printf '/bin/zsh\n'; fi ;;
+  *) exit 1 ;;
+esac
+SH
+  cat > "$fakebin/orca-lsof" <<'SH'
+#!/usr/bin/env bash
+printf 'p4242\nn%s\n' "$ORCA_TEST_WT"
+SH
+  chmod +x "$fakebin/orca" "$fakebin/orca-ps" "$fakebin/orca-lsof"
+  for alive in 0 1 unreadable; do
+    json=$(PATH="$fakebin:$PATH" FM_HOME="$home" NET_LOG="$home/net.log" \
+      FM_ORCA_CLI_BIN="$fakebin/orca" FM_ORCA_PS_BIN="$fakebin/orca-ps" \
+      FM_ORCA_LSOF_BIN="$fakebin/orca-lsof" ORCA_TEST_WT="$worktree" ORCA_TEST_ALIVE="$alive" \
+      "$ROOT/bin/fm-fleet-snapshot.sh" --json) || fail "Orca bound secondmate snapshot failed"
+    case "$alive" in 0) expected=dead ;; 1) expected=alive ;; unreadable) expected=unknown ;; esac
+    printf '%s' "$json" | jq -e --arg expected "$expected" '
+      .tasks[] | select(.id == "mate") | .endpoint.agent_alive == $expected
+        and (if $expected == "unknown" then .endpoint.exists == null and .endpoint.status == "unknown" else .endpoint.exists == true end)
+    ' >/dev/null || fail "snapshot lost captured Orca process binding ($expected): $json"
+  done
+  pass "Orca secondmate snapshots distinguish shell, harness, and unreadable endpoint"
+}
