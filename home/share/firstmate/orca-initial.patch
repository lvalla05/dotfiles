+    "teardown should surface the Orca terminal-close error"
+  assert_not_contains "$(cat "$LOG")" $'orca\x1f''worktree'$'\x1f''rm' \
+    "teardown should preserve the worktree when terminal close is unconfirmed"
+  assert_present "$state/$id.meta" "failed Orca close should preserve task metadata"
+  pass "fm-teardown.sh backend=orca: preserves recoverable state on terminal close failure"
+}
