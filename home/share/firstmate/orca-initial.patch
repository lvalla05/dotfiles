+  fm_backend_orca_runtime_check || return 1
+  fm_backend_orca_worktree_id_valid "$worktree_id" "$canonical" || {
+    echo "error: Orca worktree id does not embed the registered home path for $id" >&2
+    return 1
+  }
+  orca_owner_runtime_path_matches "$worktree_id" "$canonical" || return 1
+  marker="$canonical/$SUB_HOME_ORCA_MARKER"
+  if [ -e "$marker" ] || [ -L "$marker" ]; then
+    orca_owner_marker_load "$marker" "$id" "$canonical" || return 1
+    [ "$ORCA_OWNER_WORKTREE_ID" = "$worktree_id" ] || {
+      echo "error: existing Orca ownership marker names another worktree" >&2
+      return 1
+    }
+  else
+    orca_owner_marker_write "$canonical" "$id" "$worktree_id" || return 1
+  fi
+  seed_registry_lock_release
+  trap - EXIT
+  printf 'home=%s\n' "$canonical"
+}
+
+orca_recovery_terminal_inventory() {  # <worktree-id> <canonical-home>
+  local worktree_id=$1 home=$2 out
+  out=$(orca terminal list --worktree "id:$worktree_id" --limit 1000 \
+    --include-visual-layouts --json) || return 1
+  # shellcheck disable=SC2016  # JavaScript template interpolation is literal shell input.
+  printf '%s' "$out" | node -e '
+const fs = require("fs");
+const expectedId = process.argv[1];
+const expectedPath = process.argv[2];
+let data;
+try { data = JSON.parse(fs.readFileSync(0, "utf8")); } catch { process.exit(1); }
+const result = data && data.ok !== false && data.result;
+if (!result || !Array.isArray(result.terminals) || result.truncated !== false ||
+    !Number.isInteger(result.totalCount) || result.totalCount !== result.terminals.length ||
+    !result.hostScope || !Array.isArray(result.hostScope.omittedHostIds) ||
+    result.hostScope.omittedHostIds.length !== 0) process.exit(1);
+const safe = (value) => typeof value === "string" && value.length > 0 && !/[\u0000-\u001f\u007f]/u.test(value);
+const seen = new Set();
+for (const terminal of result.terminals) {
+  if (!terminal || terminal.orphaned === true || !safe(terminal.handle) ||
+      terminal.worktreeId !== expectedId || terminal.worktreePath !== expectedPath ||
+      terminal.executionHostId !== "local" || seen.has(terminal.handle)) process.exit(1);
+  seen.add(terminal.handle);
+  process.stdout.write(`${terminal.handle}\n`);
+}
+' "$worktree_id" "$home"
+}
+
+orca_recovery_registry_conflict() {  # <id> <canonical-home>
+  local expected_id=$1 expected_home=$2 line registered_home registered_abs
+  [ -f "$REG" ] || return 1
+  while IFS= read -r line || [ -n "$line" ]; do
+    case "$line" in
+      "- "*)
+        secondmate_registry_parse_line "$line" || return 0
+        registered_home=$SECONDMATE_REGISTRY_HOME
+        registered_abs=$(resolved_path "$registered_home" 2>/dev/null || true)
+        if [ "$SECONDMATE_REGISTRY_ID" = "$expected_id" ] || [ "$registered_abs" = "$expected_home" ]; then
+          return 0
+        fi
+        ;;
+    esac
+  done < "$REG"
+  return 1
+}
+
+recover_orca_seed() {  # <path-to-marker> [--force]
+  local marker_arg=$1 force=${2:-} marker home id terminals terminal_count worktree_id recovery force_recovery
+  case "$marker_arg" in
+    */"$SUB_HOME_ORCA_MARKER") ;;
+    *) echo "error: recover-orca requires the exact path to $SUB_HOME_ORCA_MARKER" >&2; return 1 ;;
+  esac
+  [ -f "$marker_arg" ] && [ ! -L "$marker_arg" ] || {
+    echo "error: Orca recovery marker is missing or unsafe: $marker_arg" >&2
+    return 1
+  }
+  home=$(seed_rollback_target "$(dirname "$marker_arg")" "Orca recovery home") || return 1
+  marker="$home/$SUB_HOME_ORCA_MARKER"
+  [ "$marker" = "$(resolved_path "$marker_arg")" ] || {
+    echo "error: Orca recovery marker path does not resolve inside its named home" >&2
+    return 1
+  }
+  id=$(fm_backend_meta_exact_value "$marker" id 2>/dev/null || true)
+  case "$id" in ''|*[!A-Za-z0-9._-]*) echo "error: Orca recovery marker has an invalid secondmate id" >&2; return 1 ;; esac
+  orca_owner_marker_load "$marker" "$id" "$home" || return 1
+  worktree_id=$ORCA_OWNER_WORKTREE_ID
+  mkdir -p "$STATE" || return 1
+  SEED_REGISTRY_LOCK=$(secondmate_registry_lock_path "$STATE")
+  fm_lock_acquire_wait "$SEED_REGISTRY_LOCK" || return 1
+  SEED_REGISTRY_LOCK_HELD=1
+  trap seed_registry_lock_release EXIT
+  validate_registry || return 1
+  if orca_recovery_registry_conflict "$id" "$home"; then
+    echo "error: Orca recovery refused because secondmate $id or home $home is still registered; use normal teardown" >&2
+    return 1
+  fi
+  if [ -e "$STATE/$id.meta" ] || [ -L "$STATE/$id.meta" ]; then
+    echo "error: Orca recovery refused because task state still exists at $STATE/$id.meta; use normal teardown" >&2
+    return 1
+  fi
+  fm_backend_source orca || return 1
+  fm_backend_orca_runtime_check || return 1
+  orca_owner_runtime_path_matches "$worktree_id" "$home" || return 1
+  recovery=$(seed_orca_recovery_command "$marker" "$force")
+  force_recovery=$(seed_orca_recovery_command "$marker" --force)
+  if ! terminals=$(orca_recovery_terminal_inventory "$worktree_id" "$home"); then
+    echo "error: could not account for every terminal in Orca worktree $worktree_id; retained $marker" >&2
+    echo "recovery: $recovery" >&2
+    return 1
+  fi
+  if [ -n "$ORCA_OWNER_STARTUP_TERMINAL" ] \
+     && ! printf '%s\n' "$terminals" | grep -Fx -- "$ORCA_OWNER_STARTUP_TERMINAL" >/dev/null 2>&1; then
+    echo "recovery: recorded startup terminal $ORCA_OWNER_STARTUP_TERMINAL is no longer live in the exact worktree inventory" >&2
+  fi
+  if [ -n "$terminals" ]; then
+    terminal_count=$(printf '%s\n' "$terminals" | awk 'NF { count++ } END { print count + 0 }')
+    if [ "$force" != --force ]; then
+      echo "error: non-forced Orca recovery refuses $terminal_count live terminal(s) in exact worktree $worktree_id: $(printf '%s' "$terminals" | paste -sd, -)" >&2
+      echo "recovery: inspect that work, then explicitly discard it with: $force_recovery" >&2
+      return 1
+    fi
+    echo "recovery: force-removing exact Orca worktree $worktree_id with $terminal_count verified terminal(s): $(printf '%s' "$terminals" | paste -sd, -)" >&2
+  else
+    echo "recovery: ${force:+force-}removing exact Orca worktree $worktree_id with no live terminals" >&2
+  fi
+  if ! fm_backend_remove_worktree orca "$worktree_id" "$force"; then
+    echo "error: Orca recovery removal was not confirmed; retained $marker" >&2
+    if [ "$force" = --force ]; then
+      echo "recovery: $recovery" >&2
+    else
+      echo "recovery: inspect the retained work, then explicitly discard it with: $force_recovery" >&2
+    fi
+    return 1
+  fi
+  if [ -e "$home" ] || [ -L "$home" ]; then
+    echo "error: Orca reported removal but recovery home still exists; retained $marker" >&2
+    echo "recovery: $recovery" >&2
+    return 1
+  fi
+  seed_registry_lock_release
+  trap - EXIT
+  printf 'recovered=%s\n' "$worktree_id"
+}
+
 case "${1:-}" in
   validate)
     [ $# -eq 1 ] || { usage; exit 1; }
     validate_registry
     ;;
+  adopt-orca)
+    [ $# -eq 3 ] || { usage; exit 1; }
+    adopt_orca_home "$2" "$3"
+    ;;
+  recover-orca)
+    case "$#:${2:-}" in
+      2:--force) usage; exit 1 ;;
+      2:*) recover_orca_seed "$2" ;;
+      3:--force) recover_orca_seed "$3" --force ;;
+      *) usage; exit 1 ;;
+    esac
+    ;;
   -h|--help|'')
     usage
     exit 0
