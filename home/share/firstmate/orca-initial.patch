+fm_orca_process_cli() {
+  local verb=${1-} key
+  shift || true
+  [ "$verb" = bind ] || { echo "usage: fm-orca-process-lib.sh bind --meta PATH --state DIR --task ID --terminal HANDLE --spawn-gen GEN --shell-pid PID" >&2; return 2; }
+  FM_ORCA_BIND_META=''
+  FM_ORCA_BIND_STATE=''
+  FM_ORCA_BIND_TASK=''
+  FM_ORCA_BIND_TERMINAL=''
+  FM_ORCA_BIND_SPAWN_GEN=''
+  FM_ORCA_BIND_SHELL_PID=''
+  while [ "$#" -gt 0 ]; do
+    case "$1" in
+      --meta|--state|--task|--terminal|--spawn-gen|--shell-pid)
+        key=${1#--}; shift
+        [ "$#" -gt 0 ] || return 2
+        case "$key" in
+          meta) FM_ORCA_BIND_META=$1 ;; state) FM_ORCA_BIND_STATE=$1 ;;
+          task) FM_ORCA_BIND_TASK=$1 ;; terminal) FM_ORCA_BIND_TERMINAL=$1 ;;
+          spawn-gen) FM_ORCA_BIND_SPAWN_GEN=$1 ;; shell-pid) FM_ORCA_BIND_SHELL_PID=$1 ;;
+        esac
+        ;;
+      *) return 2 ;;
+    esac
+    shift
+  done
+  [ -n "$FM_ORCA_BIND_META" ] && [ -n "$FM_ORCA_BIND_STATE" ] \
+    && [ -n "$FM_ORCA_BIND_TASK" ] && [ -n "$FM_ORCA_BIND_TERMINAL" ] \
+    && [ -n "$FM_ORCA_BIND_SPAWN_GEN" ] && [ -n "$FM_ORCA_BIND_SHELL_PID" ] || return 2
+  fm_orca_process_bind || {
+    echo "error: local Orca process binding was refused; the harness was not launched" >&2
+    return 1
+  }
+}
+
+if [ -n "${BASH_VERSION:-}" ] && [ "${BASH_SOURCE[0]}" = "$0" ]; then
+  set -u
+  fm_orca_process_cli "$@"
+fi
