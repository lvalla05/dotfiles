{
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": false,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "crossSessionInbound": "hold",
  "autoContinueAtUsageLimit": true,
  "cleanupPeriodDays": 180,
  "timeZone": "America/New_York",
  "timeFormat": "12-hour",
  "workflowSizeGuideline": "medium",
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)"
    ],
    "ask": [],
    "defaultMode": "bypassPermissions"
  },
  "sandbox": {
    "enabled": false,
    "excludedCommands": [
      "orca *",
      "gh *",
      "brew *",
      "nix *",
      "darwin-rebuild *",
      "sudo *",
      "op *",
      "av *",
      "docker *"
    ],
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws/credentials",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        }
      ]
    }
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "CLAUDE_CODE_GOAL_CHECKIN_MINUTES": "0"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$used\" ]; then printf \"%s | ctx: %.0f%% used\" \"$model\" \"$used\"; else printf \"%s\" \"$model\"; fi"
  },
  "theme": "dark-ansi",
  "hooks": {}
}
