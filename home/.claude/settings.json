{
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "crossSessionInbound": "hold",
  "autoContinueAtUsageLimit": true,
  "cleanupPeriodDays": 180,
  "timeZone": "America/New_York",
  "timeFormat": "12h",
  "workflowSizeGuideline": "medium",
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.brain/health/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)",
      "mcp__*send_message*",
      "mcp__*__reply",
      "mcp__*__forward",
      "mcp__*trash_*",
      "mcp__*delete_*",
      "mcp__*respond_to_event"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(brew uninstall:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(darwin-rebuild:*)",
      "Bash(dangerouslyDisableSandbox:true)",
      "mcp__*create_event*",
      "mcp__*update_event*"
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": ["gh *", "brew *", "nix *", "darwin-rebuild *", "sudo *", "op *", "av *", "docker *"],
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws/credentials", "mode": "deny" },
        { "path": "~/.brain/health", "mode": "deny" }
      ],
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" }
      ]
    }
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "CLAUDE_CODE_GOAL_CHECKIN_MINUTES": "0"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$used\" ]; then printf \"%s | ctx: %.0f%% used\" \"$model\" \"$used\"; else printf \"%s\" \"$model\"; fi"
  },
  "theme": "dark-ansi"
}
