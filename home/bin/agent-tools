#!/usr/bin/env bash
# Install all or selected pinned CLIs from agent-tools.lock into ~/.local/bin.
# Explicit prefixes make this work before the managed ~/.npmrc link is active.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)"
lock="$here/agent-tools.lock"
names=() kinds=() packages=() versions=()
while read -r kind name version _; do
  case "$kind" in
    ''|'#'*) continue ;;
    go|npm|npmx) ;;
    *)   echo "unknown kind '$kind' in $lock"; exit 1 ;;
  esac
  if [ -z "$name" ] || [[ ! "$version" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.-]+)?$ ]]; then
    echo "unpinned or malformed entry '$kind $name $version' in $lock" >&2
    exit 1
  fi
  short="${name##*/}"
  [ "$name" != '@earendil-works/pi-coding-agent' ] || short=pi
  for existing in "${names[@]}"; do
    [ "$existing" != "$short" ] || { echo "duplicate tool '$short' in $lock" >&2; exit 1; }
  done
  names+=("$short"); kinds+=("$kind"); packages+=("$name"); versions+=("$version")
done < "$lock"

if [ "${1:-}" = --list ]; then
  for i in "${!names[@]}"; do printf '%-14s %s@%s\n' "${names[$i]}" "${packages[$i]}" "${versions[$i]}"; done
  exit 0
fi
if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then
  echo 'Usage: agent-tools [--list | tool ...]'
  echo 'No arguments installs all pinned tools. Example: agent-tools pi quota-axi'
  exit 0
fi

selected=()
if [ "$#" = 0 ]; then
  selected=("${!names[@]}")
else
  for requested in "$@"; do
    found=false
    for i in "${!names[@]}"; do
      if [ "$requested" = "${names[$i]}" ]; then selected+=("$i"); found=true; break; fi
    done
    if [ "$found" = false ]; then echo "unknown tool '$requested'; run agent-tools --list" >&2; exit 1; fi
  done
fi

# Validate every selection and required installer before the first package mutation.
for i in "${selected[@]}"; do
  installer=npm
  [ "${kinds[$i]}" != go ] || installer=go
  command -v "$installer" >/dev/null || { echo "$installer is missing; run ./rebuild.sh first" >&2; exit 1; }
done
export GOBIN="$HOME/.local/bin"
export GOTOOLCHAIN="${GOTOOLCHAIN:-auto}"
mkdir -p "$GOBIN"
for i in "${selected[@]}"; do
  package="${packages[$i]}@${versions[$i]}"
  printf '==> install %s\n' "$package"
  case "${kinds[$i]}" in
    go) go install "$package" ;;
    npm) npm install --global --prefix "$HOME/.local" "$package" ;;
    npmx) npm install --global --ignore-scripts --prefix "$HOME/.local" "$package" ;;
  esac
done

echo '==> selected tools installed; global skills are separate, explicit installs'
